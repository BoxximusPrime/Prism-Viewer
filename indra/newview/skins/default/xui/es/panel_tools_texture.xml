<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Textura">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<color_swatch name="colorswatch" tool_tip="Pulsa para abrir el selector de color" />
			<text name="color trans">Porcentaje de transparencia</text>
			<text name="glow label">Resplandor</text>
			<check_box name="checkbox fullbright" label="Brillo total" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Materiales" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Textura (difusa)" ><radio_item.check_button label="Textura (difusa)" label_selected="Textura (difusa)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Relieve (normal)" ><radio_item.check_button label="Relieve (normal)" label_selected="Relieve (normal)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Brillantez (especular)" ><radio_item.check_button label="Brillantez (especular)" label_selected="Brillantez (especular)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="Bloquear repetición" tool_tip="Ajustar todas las repeticiones de mapas simultáneamente" />
			<texture_picker name="texture control" label="Textura" tool_tip="Pulsa para elegir una imagen" />
			<text name="label alphamode">Modo alfa</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Ninguno" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="Mezclado alfa" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="Máscara alfa" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Máscara de emisión lumínica" />
			</combo_box>
			<text name="label maskcutoff">Límite de máscara</text>
			<texture_picker name="bumpytexture control" label="Textura" tool_tip="Pulsa para elegir una imagen" />
			<text name="label bumpiness">Rugosidad</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Ninguna" />
				<combo_box.item name="Brightness" value="Brightness" label="Claridad" />
				<combo_box.item name="Darkness" value="Darkness" label="Oscuridad" />
				<combo_box.item name="woodgrain" value="woodgrain" label="madera" />
				<combo_box.item name="bark" value="bark" label="corteza" />
				<combo_box.item name="bricks" value="bricks" label="ladrillos" />
				<combo_box.item name="checker" value="checker" label="cuadrícula" />
				<combo_box.item name="concrete" value="concrete" label="hormigón" />
				<combo_box.item name="crustytile" value="crustytile" label="azulejo" />
				<combo_box.item name="cutstone" value="cutstone" label="piedralabrada" />
				<combo_box.item name="discs" value="discs" label="discos" />
				<combo_box.item name="gravel" value="gravel" label="gravilla" />
				<combo_box.item name="petridish" value="petridish" label="placadepetri" />
				<combo_box.item name="siding" value="siding" label="revestimiento" />
				<combo_box.item name="stonetile" value="stonetile" label="baldosa" />
				<combo_box.item name="stucco" value="stucco" label="estuco" />
				<combo_box.item name="suction" value="suction" label="succión" />
				<combo_box.item name="weave" value="weave" label="tejido" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Textura" tool_tip="Pulsa para elegir una imagen" />
			<text name="label shininess">Brillo</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Ninguno" />
				<combo_box.item name="Low" value="Low" label="Bajo" />
				<combo_box.item name="Medium" value="Medium" label="Medio" />
				<combo_box.item name="High" value="High" label="Alto" />
			</combo_box>
			<text name="label glossiness">Efecto pulido</text>
			<text name="label environment">Entorno</text>
			<color_swatch name="shinycolorswatch" tool_tip="Pulsa para abrir el selector de color" />
			<text name="media_info">Espacio para la URL del media elegido, si procede</text>
			<button name="add_media" label="Elegir..." tool_tip="Añadir un media" />
			<button name="delete_media" label="Eliminar" tool_tip="Borrar esta textura para media" />
			<button name="button align" label="Centrar" label_selected="Centrar los media" tool_tip="Centrar esta textura para media (primero debe cargarse)" />
			<text name="tex gen">Representación</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="Por defecto" />
				<combo_box.item name="Planar" value="Planar" label="En el plano" />
			</combo_box>
			<spinner name="TexScaleU" label="Escala horizontal" />
			<spinner name="TexScaleV" label="Escala vertical" />
			<spinner name="rptctrl" label="Repeticiones por metro" />
			<spinner name="TexRot" label="Grados de rotación" />
			<spinner name="TexOffsetU" label="Desplazamiento horizontal" />
			<spinner name="TexOffsetV" label="Desplazamiento vertical" />
			<spinner name="bumpyScaleU" label="Escala horizontal" />
			<spinner name="bumpyScaleV" label="Escala vertical" />
			<spinner name="bumpyRot" label="Grados de rotación" />
			<spinner name="bumpyOffsetU" label="Desplazamiento horizontal" />
			<spinner name="bumpyOffsetV" label="Desplazamiento vertical" />
			<spinner name="shinyScaleU" label="Escala horizontal" />
			<spinner name="shinyScaleV" label="Escala vertical" />
			<spinner name="shinyRot" label="Grados de rotación" />
			<spinner name="shinyOffsetU" label="Desplazamiento horizontal" />
			<spinner name="shinyOffsetV" label="Desplazamiento vertical" />
			<check_box name="checkbox planar align" label="Alinear caras del plano" tool_tip="Alinear texturas en todas las caras seleccionadas con la última cara seleccionada. Requiere la representación de texturas en el plano." />
			<button name="button align textures" label="Centrar" label_selected="Alinear capas de textura actuales" tool_tip="Alinear capas de textura actuales" />
		</panel>
	</scroll_container>
</panel>