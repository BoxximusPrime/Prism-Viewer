<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Textura">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">Cor</text>
			<color_swatch name="colorswatch" tool_tip="Selecionar a cor" />
			<text name="color trans">% de transparência</text>
			<text name="glow label">Brilho</text>
			<check_box name="checkbox fullbright" label="Completamente luminoso" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Materiais" />
				<combo_box.item name="Media" value="Media" label="Mídia" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Textura (difusa)" ><radio_item.check_button label="Textura (difusa)" label_selected="Textura (difusa)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Relevo (normal)" ><radio_item.check_button label="Relevo (normal)" label_selected="Relevo (normal)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Brilho (especular)" ><radio_item.check_button label="Brilho (especular)" label_selected="Brilho (especular)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="Repetir bloqueio" tool_tip="Ajustar os mapas repetidos simultaneamente" />
			<texture_picker name="texture control" label="Textura" tool_tip="Selecionar imagem" />
			<text name="label alphamode">Modo alpha</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Nenhum" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="Mistura alpha" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="Máscara alpha" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Máscara emissiva" />
			</combo_box>
			<text name="label maskcutoff">Corte da máscara</text>
			<texture_picker name="bumpytexture control" label="Textura" tool_tip="Selecionar imagem" />
			<text name="label bumpiness">Relevo</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Nenhum" />
				<combo_box.item name="Brightness" value="Brightness" label="Luminosidade" />
				<combo_box.item name="Darkness" value="Darkness" label="Escuridão" />
				<combo_box.item name="woodgrain" value="woodgrain" label="grão de madeira" />
				<combo_box.item name="bark" value="bark" label="casca de árvore" />
				<combo_box.item name="bricks" value="bricks" label="tijolos" />
				<combo_box.item name="checker" value="checker" label="quadriculado" />
				<combo_box.item name="concrete" value="concrete" label="concreto" />
				<combo_box.item name="crustytile" value="crustytile" label="ladrilho ríspido" />
				<combo_box.item name="cutstone" value="cutstone" label="pedra talhada" />
				<combo_box.item name="discs" value="discs" label="discos" />
				<combo_box.item name="gravel" value="gravel" label="cascalho" />
				<combo_box.item name="petridish" value="petridish" label="placa de petri" />
				<combo_box.item name="siding" value="siding" label="desvio" />
				<combo_box.item name="stonetile" value="stonetile" label="ladrilho de pedra" />
				<combo_box.item name="stucco" value="stucco" label="estuque" />
				<combo_box.item name="suction" value="suction" label="sucção" />
				<combo_box.item name="weave" value="weave" label="tecelagem" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Textura" tool_tip="Selecionar imagem" />
			<text name="label shininess">Brilho</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Nenhum" />
				<combo_box.item name="Low" value="Low" label="Baixo" />
				<combo_box.item name="Medium" value="Medium" label="Médio" />
				<combo_box.item name="High" value="High" label="Alto" />
			</combo_box>
			<text name="label glossiness">Acetinação</text>
			<text name="label environment">Ambiente</text>
			<text name="label shinycolor">Cor</text>
			<color_swatch name="shinycolorswatch" tool_tip="Selecionar a cor" />
			<text name="media_info">A URL da mídia escolhida, caso haja, é inserida aqui</text>
			<button name="add_media" label="Selecionar..." tool_tip="Adicionar mídia" />
			<button name="delete_media" label="Remover" tool_tip="Excluir esta textura de mídia" />
			<button name="button align" label="Alinhar" label_selected="Alinhar mídia" tool_tip="Alinhar texturas de mídia (após carregar mídia)" />
			<text name="tex gen">Mapeamento</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="Padrão" />
			</combo_box>
			<spinner name="TexScaleU" label="Escala horizontal" />
			<spinner name="TexScaleV" label="Escala vertical" />
			<spinner name="rptctrl" label="Repetições por metro" />
			<spinner name="TexRot" label="Graus de rotação" />
			<spinner name="TexOffsetU" label="Offset horizontal" />
			<spinner name="TexOffsetV" label="Offset vertical" />
			<spinner name="bumpyScaleU" label="Escala horizontal" />
			<spinner name="bumpyScaleV" label="Escala vertical" />
			<spinner name="bumpyRot" label="Graus de rotação" />
			<spinner name="bumpyOffsetU" label="Offset horizontal" />
			<spinner name="bumpyOffsetV" label="Offset vertical" />
			<spinner name="shinyScaleU" label="Escala horizontal" />
			<spinner name="shinyScaleV" label="Escala vertical" />
			<spinner name="shinyRot" label="Graus de rotação" />
			<spinner name="shinyOffsetU" label="Offset horizontal" />
			<spinner name="shinyOffsetV" label="Offset vertical" />
			<check_box name="checkbox planar align" label="Alinhar planos planares" tool_tip="Alinhar texturas de todos os planos selecionados com o plano selecionado por último. Requer mapeamento de textura planar." />
			<button name="button align textures" label="Alinhar" label_selected="Alinhar camadas de textura atual" tool_tip="Alinhar camadas de textura atual" />
		</panel>
	</scroll_container>
</panel>