<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Texture">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">Couleur</text>
			<color_swatch name="colorswatch" tool_tip="Cliquez pour ouvrir le sélecteur de couleurs" />
			<text name="color trans">% de transparence</text>
			<text name="glow label">Rayonnement</text>
			<check_box name="checkbox fullbright" label="Lumineux" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Matériaux" />
				<combo_box.item name="Media" value="Media" label="Médias" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Texture (diffuse)" ><radio_item.check_button label="Texture (diffuse)" label_selected="Texture (diffuse)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Relief (normal)" ><radio_item.check_button label="Relief (normal)" label_selected="Relief (normal)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Brillance (spéculaire)" ><radio_item.check_button label="Brillance (spéculaire)" label_selected="Brillance (spéculaire)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="Verrouiller la fonction répéter" tool_tip="L'ajustement des cartes se fait simultanément" />
			<texture_picker name="texture control" label="Texture" tool_tip="Cliquer pour sélectionner une image." />
			<text name="label alphamode">Mode alpha</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Aucun" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="Fusion alpha" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="Masquage alpha" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Masque émissif" />
			</combo_box>
			<text name="label maskcutoff">Coupe du masque</text>
			<texture_picker name="bumpytexture control" label="Texture" tool_tip="Cliquer pour sélectionner une image." />
			<text name="label bumpiness">Relief</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Aucun" />
				<combo_box.item name="Brightness" value="Brightness" label="Luminosité" />
				<combo_box.item name="Darkness" value="Darkness" label="Obscurité" />
				<combo_box.item name="woodgrain" value="woodgrain" label="aggloméré" />
				<combo_box.item name="bark" value="bark" label="écorce" />
				<combo_box.item name="bricks" value="bricks" label="briques" />
				<combo_box.item name="checker" value="checker" label="damier" />
				<combo_box.item name="concrete" value="concrete" label="béton" />
				<combo_box.item name="crustytile" value="crustytile" label="carrelage" />
				<combo_box.item name="cutstone" value="cutstone" label="pierre de taille" />
				<combo_box.item name="discs" value="discs" label="disques" />
				<combo_box.item name="gravel" value="gravel" label="gravier" />
				<combo_box.item name="petridish" value="petridish" label="boîte de Petri" />
				<combo_box.item name="siding" value="siding" label="lattes" />
				<combo_box.item name="stonetile" value="stonetile" label="carreaux" />
				<combo_box.item name="stucco" value="stucco" label="stuc" />
				<combo_box.item name="suction" value="suction" label="ventouses" />
				<combo_box.item name="weave" value="weave" label="tissage" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Texture" tool_tip="Cliquer pour sélectionner une image." />
			<text name="label shininess">Brillance</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Aucune" />
				<combo_box.item name="Low" value="Low" label="Faible" />
				<combo_box.item name="Medium" value="Medium" label="Moyenne" />
				<combo_box.item name="High" value="High" label="Élevée" />
			</combo_box>
			<text name="label glossiness">Lustrage</text>
			<text name="label environment">Environnement</text>
			<text name="label shinycolor">Couleur</text>
			<color_swatch name="shinycolorswatch" tool_tip="Cliquez pour ouvrir le sélecteur de couleurs" />
			<text name="media_info">L'URL du média choisi, le cas échéant, se place ici.</text>
			<button name="add_media" label="Choisir..." tool_tip="Ajouter un média" />
			<button name="delete_media" label="Supprimer" tool_tip="Supprimer cette texture de média" />
			<button name="button align" label="Aligner" label_selected="Aligner le média" tool_tip="Ajuster la texture du média (le chargement doit d’abord se terminer)" />
			<text name="tex gen">Application</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="Valeur par défaut" />
				<combo_box.item name="Planar" value="Planar" label="Plan" />
			</combo_box>
			<spinner name="TexScaleU" label="Échelle horizontale" />
			<spinner name="TexScaleV" label="Échelle verticale" />
			<spinner name="rptctrl" label="Répétitions au mètre" />
			<spinner name="TexRot" label="Degrés de rotation" />
			<spinner name="TexOffsetU" label="Décalage horizontal" />
			<spinner name="TexOffsetV" label="Décalage vertical" />
			<spinner name="bumpyScaleU" label="Échelle horizontale" />
			<spinner name="bumpyScaleV" label="Échelle verticale" />
			<spinner name="bumpyRot" label="Degrés de rotation" />
			<spinner name="bumpyOffsetU" label="Décalage horizontal" />
			<spinner name="bumpyOffsetV" label="Décalage vertical" />
			<spinner name="shinyScaleU" label="Échelle horizontale" />
			<spinner name="shinyScaleV" label="Échelle verticale" />
			<spinner name="shinyRot" label="Degrés de rotation" />
			<spinner name="shinyOffsetU" label="Décalage horizontal" />
			<spinner name="shinyOffsetV" label="Décalage vertical" />
			<check_box name="checkbox planar align" label="Aligner les faces Plan" tool_tip="Aligner les textures sur toutes les faces sélectionnées avec la dernière face sélectionnée. Application de la texture Plan requise." />
			<button name="button align textures" label="Aligner" label_selected="Aligner les couches de texture actuelles" tool_tip="Aligner les couches de texture actuelles" />
		</panel>
	</scroll_container>
</panel>