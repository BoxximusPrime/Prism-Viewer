<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="テクスチャ">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">色</text>
			<color_swatch name="colorswatch" tool_tip="クリックしてカラーピッカーを開きます" />
			<text name="color trans">透過度％</text>
			<text name="glow label">グロー</text>
			<check_box name="checkbox fullbright" label="明るさ全開" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="材質" />
				<combo_box.item name="Media" value="Media" label="メディア" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="テクスチャ (拡散)" ><radio_item.check_button label="テクスチャ (拡散)" label_selected="テクスチャ (拡散)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="凹凸 (法線)" ><radio_item.check_button label="凹凸 (法線)" label_selected="凹凸 (法線)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="輝き (反射)" ><radio_item.check_button label="輝き (反射)" label_selected="輝き (反射)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="繰り返しをロックする" tool_tip="すべてのマップの繰り返しを調整する" />
			<texture_picker name="texture control" label="テクスチャ" tool_tip="クリックして画像を選択します" />
			<text name="label alphamode">アルファモード</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="なし" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="アルファブレンディング" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="アルファマスキング" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="放射状マスク" />
			</combo_box>
			<text name="label maskcutoff">マスクカットオフ</text>
			<texture_picker name="bumpytexture control" label="テクスチャ" tool_tip="クリックして画像を選択します" />
			<text name="label bumpiness">凹凸</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="なし" />
				<combo_box.item name="Brightness" value="Brightness" label="明るさ" />
				<combo_box.item name="Darkness" value="Darkness" label="暗い" />
				<combo_box.item name="woodgrain" value="woodgrain" label="木目調" />
				<combo_box.item name="bark" value="bark" label="樹皮" />
				<combo_box.item name="bricks" value="bricks" label="レンガ" />
				<combo_box.item name="checker" value="checker" label="市松模様" />
				<combo_box.item name="concrete" value="concrete" label="コンクリート" />
				<combo_box.item name="crustytile" value="crustytile" label="堅いタイル" />
				<combo_box.item name="cutstone" value="cutstone" label="カットストーン" />
				<combo_box.item name="discs" value="discs" label="円板" />
				<combo_box.item name="gravel" value="gravel" label="小石" />
				<combo_box.item name="petridish" value="petridish" label="ペトリ皿" />
				<combo_box.item name="siding" value="siding" label="側線" />
				<combo_box.item name="stonetile" value="stonetile" label="ストーンタイル" />
				<combo_box.item name="stucco" value="stucco" label="化粧しっくい" />
				<combo_box.item name="suction" value="suction" label="吸盤" />
				<combo_box.item name="weave" value="weave" label="織物" />
			</combo_box>
			<texture_picker name="shinytexture control" label="テクスチャ" tool_tip="クリックして画像を選択します" />
			<text name="label shininess">輝き</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="なし" />
				<combo_box.item name="Low" value="Low" label="低" />
				<combo_box.item name="Medium" value="Medium" label="中" />
				<combo_box.item name="High" value="High" label="高" />
			</combo_box>
			<text name="label glossiness">光沢度</text>
			<text name="label environment">環境</text>
			<text name="label shinycolor">色</text>
			<color_swatch name="shinycolorswatch" tool_tip="クリックしてカラーピッカーを開きます" />
			<text name="media_info">選択したメディアのURLがもしあれば、ここに入ります。</text>
			<button name="add_media" label="選択…" tool_tip="メディアを追加します" />
			<button name="delete_media" label="削除" tool_tip="このメディアテクスチャを削除します" />
			<button name="button align" label="揃える" label_selected="メディアを一列に揃えます" tool_tip="メディアテクスチャを一列に揃える（最初に読み込む必要があります）" />
			<text name="tex gen">マッピング</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="デフォルト" />
				<combo_box.item name="Planar" value="Planar" label="平面" />
			</combo_box>
			<spinner name="TexScaleU" label="水平スケール" />
			<spinner name="TexScaleV" label="垂直スケール" />
			<spinner name="rptctrl" label="メーターごとに繰り返す" />
			<spinner name="TexRot" label="回転度" />
			<spinner name="TexOffsetU" label="水平オフセット" />
			<spinner name="TexOffsetV" label="垂直オフセット" />
			<spinner name="bumpyScaleU" label="水平スケール" />
			<spinner name="bumpyScaleV" label="垂直スケール" />
			<spinner name="bumpyRot" label="回転度" />
			<spinner name="bumpyOffsetU" label="水平オフセット" />
			<spinner name="bumpyOffsetV" label="垂直オフセット" />
			<spinner name="shinyScaleU" label="水平スケール" />
			<spinner name="shinyScaleV" label="垂直スケール" />
			<spinner name="shinyRot" label="回転度" />
			<spinner name="shinyOffsetU" label="水平オフセット" />
			<spinner name="shinyOffsetV" label="垂直オフセット" />
			<check_box name="checkbox planar align" label="平面を揃える" tool_tip="選択面全てのテクスチャを、最後に選択された面に揃えます。平面テクスチャのマッピングが必要です。" />
			<button name="button align textures" label="揃える" label_selected="現在のテクスチャレイヤーを揃える" tool_tip="現在のテクスチャレイヤーを揃える" />
		</panel>
	</scroll_container>
</panel>