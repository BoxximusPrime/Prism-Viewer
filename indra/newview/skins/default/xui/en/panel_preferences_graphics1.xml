<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="left|top|right|bottom"
 height="438"
 label="Graphics"
 layout="topleft"
 left="102"
 name="Display panel"
 top="1"
 width="517">

  <tab_container
    follows="all"
    height="438"
    layout="topleft"
    left="0"
    name="graphics_tab_container"
    tab_position="top"
    top="0"
    width="517">
  <panel
    follows="all"
    height="410"
    label="General"
    layout="topleft"
    name="graphics_general_panel"
    width="517">

  <text
    follows="top|left|right"
    height="16"
    layout="topleft"
    left="5"
    top="5"
    width="100">
      Preset in use:
  </text>

  <text
    follows="top|left|right"
    height="16"
    layout="topleft"
    left_delta="110"
    name="preset_text"
    top="5"
    width="320">
      (None)
  </text>

  <text
    type="string"
    length="1"
    follows="left|top"
    height="12"
    layout="topleft"
    left="10"
    name="QualitySpeed"
    top_delta="35" 
    width="400">
      Quality &amp; speed:
  </text>
  <text
    type="string"
    length="1"
    follows="left|top"
    halign="center"
    height="12"
    layout="topleft"
    left="118"
    name="ShadersPrefText"
    top_delta="0"
    width="80">
       Low
  </text>
  <text
    type="string"
    length="1"
    follows="left|top"
    halign="center"
    height="12"
    layout="topleft"
    left_delta="87"
    name="ShadersPrefText2"
    top_delta="0"
    width="80">
       Mid
  </text>
  <text
    type="string"
    length="1"
    follows="left|top"
    halign="center"
    height="12"
    layout="topleft"
    left_delta="87"
    name="ShadersPrefText3"
    top_delta="0"
    width="80">
       High
  </text>
  <text
    type="string"
    length="1"
    follows="left|top"
    halign="center"
    height="12"
    layout="topleft"
    left_delta="85"
    name="ShadersPrefText4"
    top_delta="0"
    width="80">
       Ultra
  </text>
  <text
    type="string"
    length="1"
    follows="left|top"
    halign="right"
    height="12"
    layout="topleft"
    left="65"
    name="FasterText"
    top_pad="10"
    width="80">
      Faster
  </text>
  <text
    type="string"
    length="1"
    follows="left|top"
    height="12"
    layout="topleft"
    left_delta="363"
    name="BetterText"
    top_delta="0"
    width="100">
      Better
  </text>
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left="158"
    name="LowGraphicsDivet"
    top_delta="-2"
    width="2" />
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left_pad="41"
    name="LowMidGraphicsDivet"
    width="2" />
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left_pad="41"
    name="MidGraphicsDivet"
    top_delta="0"
    width="2" />
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left_pad="41"
    name="MidHighGraphicsDivet"
    top_delta="0"
    width="2" />
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left_pad="41"
    name="HighGraphicsDivet"
    top_delta="0"
    width="2" />
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left_pad="41"
    name="HighUltraGraphicsDivet"
    top_delta="0"
    width="2" />
  <icon
    color="DkGray0"
    height="14"
    image_name="Rounded_Square"
    layout="topleft"
    left_pad="41"
    name="UltraGraphicsDivet"
    top_delta="0"
    width="2" />
  <slider
    control_name="RenderQualityPerformance"
    decimal_digits="0"
    follows="left|top"
    height="16"
    increment="1"
    initial_value="0"
    layout="topleft"
    left="150"
    max_val="6"
    name="QualityPerformanceSelection"
    show_text="false"
    top_delta="-2"
    width="275">
    <slider.commit_callback
      function="Pref.QualityPerformance"/>
  </slider>

<!-- This block shows Basic Settings -->

  <slider
    control_name="RenderFarClip"
    decimal_digits="0"
    follows="left|top"
    height="16"
    increment="8"
    initial_value="160"
    label="Draw distance:"
    label_width="187"
    layout="topleft"
    left="30"
    min_val="64"
    max_val="512"
    name="DrawDistance"
    top_delta="34"
    width="428" />
  <text
    type="string"
    length="1"
    follows="left|top"
    height="12"
    layout="topleft"
    left_delta="425"
    name="DrawDistanceMeterText2"
    top_delta="0"
    width="128">
     m
  </text>

  <button
  height="23"
  label="Automatic adjustments settings"
  layout="topleft"
  left="30"
  name="AutoAdjustmentsButton"
  top_delta="30"
  width="200">
    <button.commit_callback
      function="Pref.AutoAdjustments"/>
  </button>

  <slider
    control_name="RenderExposure"
    enabled_control="RenderDisableVintageMode"
    decimal_digits="1"
    follows="left|top"
    height="16"
    increment="0.1"
    initial_value="160"
    label="Brightness (exposure)"
    label_width="187"
    layout="topleft"
    left="30"
    min_val="0.5"
    max_val="4.0"
    name="RenderExposure"
    show_text="true"
    top_pad="14"
    width="424">
  </slider>

<!-- End of Basic Settings block -->

  <button
    follows="top|left"
    height="23"
    label="Save settings as a preset..."
    layout="topleft"
    left="10"
    name="PrefSaveButton"
    top="310"
    width="200">
    <button.commit_callback
      function="Pref.PrefSave"
      parameter="graphic" />
  </button>

  <button
    follows="top|left"
    height="23"
    label="Load preset..."
    layout="topleft"
    left_pad="10"
    name="PrefLoadButton"
    top_delta="0"
    width="115">
    <button.commit_callback
      function="Pref.PrefLoad"
	  parameter="graphic"/>
  </button>

  <button
    follows="top|left"
    height="23"
    label="Delete preset..."
    layout="topleft"
    left_pad="10"
    name="PrefDeleteButton"
    top_delta="0"
    width="115">
    <button.commit_callback
      function="Pref.PrefDelete"
	  parameter="graphic"/>
  </button>

  <button
    follows="top|left"
    height="23"
    label="Reset to recommended settings"
    layout="topleft"
    left="10"
    name="Defaults"
    top_delta="65"
    width="210">
    <button.commit_callback
      function="Pref.HardwareDefaults" />
  </button>

  <button
    follows="top|left"
    height="23"
    label="Advanced Settings..."
    layout="topleft"
    left_pad="10"
    name="AdvancedSettings"
    top_delta="0"
    width="200">
    <button.commit_callback
      function="Pref.Advanced"
      parameter="advanced" />
  </button>

  </panel>

  <panel
    follows="all"
    height="410"
    label="Avatar"
    layout="topleft"
    name="graphics_avatar_panel"
    width="517">

    <text follows="left|top" height="16" layout="topleft" left="30"
      name="AvatarComplexityModeLabel" text_readonly_color="LabelDisabledColor"
      top="28" width="128">Avatar display:</text>
    <combo_box control_name="RenderAvatarComplexityMode" height="23" layout="topleft"
      left="160" name="AvatarComplexityMode" top="24" width="150">
      <combo_box.item label="Limit by complexity" name="0" value="0"/>
      <combo_box.item label="Always show friends" name="1" value="1"/>
      <combo_box.item label="Only show friends" name="2" value="2"/>
    </combo_box>

    <slider control_name="IndirectMaxComplexity" follows="left|top" height="16"
      increment="1" initial_value="101" label="Avatar maximum complexity:"
      label_width="187" layout="topleft" left="30" max_val="101" min_val="1"
      name="IndirectMaxComplexity" show_text="false" top="70" width="394"
      tool_tip="Controls at what point a visually complex avatar is drawn as a JellyDoll">
      <slider.commit_callback function="Pref.UpdateIndirectMaxComplexity" parameter="IndirectMaxComlexityText" />
    </slider>
    <text follows="left|top" height="16" layout="topleft" left="428"
      name="IndirectMaxComplexityText" text_readonly_color="LabelDisabledColor"
      top="70" width="65">0</text>

    <slider control_name="IndirectMaxNonImpostors" decimal_digits="0" follows="left|top"
      height="16" increment="1" initial_value="12"
      label="Maximum number of animated avatars:" label_width="240" layout="topleft"
      left="30" max_val="66" min_val="1" name="IndirectMaxNonImpostors"
      show_text="false" top="102" width="394">
      <slider.commit_callback function="Pref.UpdateIndirectMaxNonImpostors" parameter="IndirectNonImpostorsText" />
    </slider>
    <text follows="left|top" height="16" layout="topleft" left="428"
      name="IndirectMaxNonImpostorsText" text_readonly_color="LabelDisabledColor"
      top="102" width="65">0</text>

    <button height="23" label="Exceptions..." layout="topleft" left="48"
      name="RenderExceptionsButton" top="135" width="100">
      <button.commit_callback function="Pref.RenderExceptions"/>
    </button>

    <view_border bevel_style="in" follows="left|top|right" height="1" layout="topleft"
      left="20" name="AvatarAttachmentSeparator" top="180" width="470" />

    <check_box control_name="BoxxyDisableAvatarAttachedLights" height="20"
      label="Do not render attached lights on avatars" layout="topleft" left="30"
      name="BoxxyDisableAvatarAttachedLights" top="202"
      tool_tip="Stops lights from avatar attachments from illuminating the scene." width="420" />
    <check_box control_name="BoxxyDisableAvatarAttachedParticles" height="20"
      label="Do not render attached particles on avatars" layout="topleft" left="30"
      name="BoxxyDisableAvatarAttachedParticles" top="232"
      tool_tip="Stops particle systems emitted by avatar attachments from rendering." width="420" />

  </panel>

  <panel
    follows="all"
    height="410"
    label="Skin Scattering"
    layout="topleft"
    name="graphics_skin_scattering_panel"
    width="517">
    <scroll_container name="SkinScatteringScroll" follows="all" layout="topleft"
      left="0" top="0" width="517" height="410" reserve_scroll_corner="false">
    <panel name="SkinScatteringContent" follows="left|top" layout="topleft"
      left="0" top="0" width="495" height="755">

    <text
      follows="left|top|right"
      height="34"
      layout="topleft"
      left="20"
      name="SkinScatteringDescription"
      top="8"
      width="470"
      word_wrap="true">
      Softens lighting on surfaces tagged [sss] in the linkset description (or attachment name when no description is available).
    </text>

    <check_box
      control_name="BoxxySSSEnabled"
      height="20"
      label="Enable skin subsurface scattering"
      layout="topleft"
      left="30"
      name="BoxxySSSEnabled"
      top="48"
      tool_tip="Apply skin lighting to visible [sss]-tagged surfaces, including test prims. The default avatar mesh is excluded."
      width="360">
      <check_box.commit_callback function="Pref.RenderOptionUpdate" />
    </check_box>

    <text
      follows="left|top"
      height="20"
      layout="topleft"
      left="30"
      name="BoxxySSSModeLabel"
      top="81"
      width="180">
      Scattering method:
    </text>
    <combo_box
      control_name="BoxxySSSMode"
      enabled_control="BoxxySSSEnabled"
      height="23"
      layout="topleft"
      left="210"
      name="BoxxySSSMode"
      top="77"
      tool_tip="Combined adds adjustable wrap and warm backlighting to screen diffusion. Wrapped lighting has the lowest GPU cost."
      width="270">
      <combo_box.item
        label="Wrapped lighting (faster)"
        name="WrappedLighting"
        value="0" />
      <combo_box.item
        label="Screen diffusion (quality)"
        name="ScreenDiffusion"
        value="1" />
      <combo_box.item label="Combined (diffusion + light)" name="CombinedScattering" value="2" />
      <combo_box.commit_callback function="Pref.RenderOptionUpdate" />
    </combo_box>

    <slider
      control_name="BoxxySSSStrength"
      decimal_digits="2"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Strength:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSStrength"
      show_text="true"
      top="111"
      tool_tip="Controls how strongly skin lighting wraps and diffuses."
      width="450" />

    <slider
      control_name="BoxxySSSDepth"
      decimal_digits="3"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="0.001"
      label="Diffusion depth (m):"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="0.1"
      min_val="0.001"
      name="BoxxySSSDepth"
      show_text="true"
      top="139"
      tool_tip="Sets the diffusion radius in meters for Screen diffusion and Combined modes."
      width="450" />

    <slider
      control_name="BoxxySSSWarmth"
      decimal_digits="2"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Skin tone response:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSWarmth"
      show_text="true"
      top="167"
      tool_tip="Shared tone control: warms wrapped light, favors red transmission, and spreads red diffuse light farther than blue. It affects all three scattering components."
      width="450" />

    <slider
      control_name="BoxxySSSMaxDistance"
      decimal_digits="0"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="1"
      label="Maximum distance (m):"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="128"
      min_val="1"
      name="BoxxySSSMaxDistance"
      show_text="true"
      top="195"
      tool_tip="Limits skin scattering to nearby affected surfaces to control GPU cost."
      width="450" />

    <slider
      control_name="BoxxySSSWrapAmount"
      decimal_digits="2"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Combined wrap:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSWrapAmount"
      show_text="true"
      top="223"
      tool_tip="Adds wrapped lighting in Combined mode. Zero leaves diffusion and transmission."
      width="450" />

    <slider
      control_name="BoxxySSSTransmission"
      decimal_digits="2"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Transmission brightness:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="4.0"
      min_val="0.0"
      name="BoxxySSSTransmission"
      show_text="true"
      top="251"
      tool_tip="Linearly scales shine-through brightness without changing the penetration limit. Increase to brighten thin areas such as ears."
      width="450" />

    <slider control_name="BoxxySSSPointTransmissionBoost" decimal_digits="1" follows="left|top"
      height="20" increment="0.5" label="Local transmission boost:" label_width="180"
      layout="topleft" left="30" max_val="16" min_val="0" name="BoxxySSSPointTransmissionBoost"
      show_text="true" top="279" width="450"
      tool_tip="Extra multiplier for point-light and projector shine-through. 1 is neutral; try 4 for stronger transmission. Leaves front lighting and sun/moon unchanged. Works with both measured and estimated thickness; blocked paths remain dark." />

    <slider
      control_name="BoxxySSSThickness"
      decimal_digits="1"
      follows="left|top"
      height="20"
      increment="0.5"
      label="Optical absorption:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="20.0"
      min_val="0.5"
      name="BoxxySSSThickness"
      show_text="true"
      top="307"
      tool_tip="Controls absorption in both transmission modes. 8.5 is neutral; lower values transmit more light. Estimated mode uses a fixed rounded 8.5 mm reference layer. This control does not change measured geometry or the penetration limit."
      width="450" />

    <check_box
      control_name="BoxxySSSShadowThickness"
      height="20"
      label="Use depth-based transmission"
      layout="topleft"
      left="30"
      name="BoxxySSSShadowThickness"
      top="339"
      tool_tip="Combined mode: verify matching skin entry and exit surfaces near a selected subject within 32 m. Opaque clothing and gaps between layers block transmission. Coverage and subject/light changes fade smoothly. Works with Shadows set to None. Turn off to use estimated thickness."
      width="450" />

    <slider control_name="BoxxySSSPenetration" decimal_digits="0" follows="left|top"
      height="20" increment="1" label="Penetration limit (mm):" label_width="180"
      layout="topleft" left="30" max_val="300" min_val="5" name="BoxxySSSPenetration"
      show_text="true" top="367" width="450"
      tool_tip="Maximum verified light path through skin. Light fades gradually across the entire range and reaches zero at this limit. Lower values suppress thicker regions. Requires depth-based transmission; estimated mode is unaffected." />

    <slider control_name="BoxxySSSTransmissionSmoothing" decimal_digits="0" follows="left|top"
      height="20" increment="1" label="Transmission blur (mm):" label_width="180"
      layout="topleft" left="30" max_val="100" min_val="0" name="BoxxySSSTransmissionSmoothing"
      show_text="true" top="395" width="450"
      tool_tip="Smooths transmitted light after lighting, with skin and depth checks at edges. Gentler normal filtering reduces mottling on uneven meshes. Textures and specular highlights stay sharp. The default is 70 mm; zero disables the extra buffer and two filter passes." />

    <check_box control_name="BoxxySSSPointDepth" height="20"
      label="Include point-light depth (experimental)" layout="topleft" left="30"
      name="BoxxySSSPointDepth" top="423" width="450"
      tool_tip="Include point lights in the shared two-light depth budget near the closest affected subject. Adds depth rendering and sampling work. Toggle to compare performance; disabled by default." />

    <check_box
      control_name="BoxxySSSAutoDetect"
      enabled_control="BoxxySSSEnabled"
      height="20"
      label="Detect mesh body parts on all avatars"
      layout="topleft"
      left="30"
      name="BoxxySSSAutoDetect"
      top="451"
      tool_tip="Detect your own and other avatars' mesh attachments when the linkset root name contains any whitelist term. Names load gradually for visible attachments within Maximum distance."
      width="420" />

    <check_box
      control_name="BoxxySSSShowMask"
      enabled_control="BoxxySSSEnabled"
      height="20"
      label="Highlight affected surfaces"
      layout="topleft"
      left="30"
      name="BoxxySSSShowMask"
      top="477"
      tool_tip="Highlight every surface currently receiving skin scattering for setup and testing."
      width="420" />

    <check_box control_name="BoxxySSSShowDepth" enabled_control="BoxxySSSEnabled"
      height="20" label="Debug transmission depth" layout="topleft" left="30"
      name="BoxxySSSShowDepth" top="503" width="420"
      tool_tip="Choose interpolated measured depth, or the final summed transmission, including absorption, light colors, intensity, and blur. Overrides the surface highlight. Requires depth-based transmission enabled in Combined mode." />
    <combo_box control_name="BoxxySSSDebugLight" enabled_control="BoxxySSSShowDepth"
      name="BoxxySSSDebugLight" layout="topleft" left="30" top="529" width="280" height="23">
      <combo_box.item label="Sun / moon depth" value="0" />
      <combo_box.item label="Local depth 1 (highest priority)" value="1" />
      <combo_box.item label="Local depth 2" value="2" />
      <combo_box.item label="Combined transmission (final light)" value="3" />
    </combo_box>
    <text name="SSSDepthLegend" layout="topleft" left="30" top="558" width="450"
      height="36" word_wrap="true">Depth: white 0 mm; black 300 mm / blocked; magenta unavailable.
Combined: transmitted light from all lights, including blur.</text>

    <text name="SSSWhitelistLabel" follows="left|top" layout="topleft"
      left="30" top="601" width="440" height="18">Automatic detection whitelist:</text>
    <line_editor name="BoxxySSSWhitelist" control_name="BoxxySSSWhitelist"
      enabled_control="BoxxySSSAutoDetect" follows="left|top" layout="topleft"
      left="30" top="624" width="450" height="23" max_length_bytes="2048"
      tool_tip="Separate terms with commas. Matching ignores case and finds terms anywhere in the attachment root name. Empty terms are ignored." />
    <text name="SSSWhitelistHelp" follows="left|top" layout="topleft"
      left="30" top="653" width="450" height="28" word_wrap="true">
      Comma-separated terms; body also matches eBODY. Clear the list to use only explicit [sss] tags.
    </text>

    <text
      follows="left|top|right"
      height="58"
      layout="topleft"
      left="30"
      name="SkinScatteringPerformanceNote"
      text_color="LtGray_50"
      top="687"
      width="440"
      word_wrap="true">
      Works with Shadows off. Focused depth covers nearby skin and at most two local lights; uncovered surfaces fade transmission out in depth mode. Opaque and alpha-masked surfaces only.
    </text>

    </panel>
    </scroll_container>
  </panel>
  </tab_container>

</panel>
