  <slider
    control_name="RenderQualityPerformance"
    decimal_digits="0"
    follows="left|top"
    height="16"
    increment="1"
    initial_value="0"
    layout="topleft"
    left="150"
    max_val="6"
    name="QualityPerformanceSelection"
    show_text="false"
    top_delta="-2"
    width="275">
    <slider.commit_callback
      function="Pref.QualityPerformance"/>
  </slider>

<!-- This block shows Basic Settings -->

  <slider
    control_name="RenderFarClip"
    decimal_digits="0"
    follows="left|top"
    height="16"
    increment="8"
    initial_value="160"
    label="Draw distance:"
    label_width="187"
    layout="topleft"
    left="30"
    min_val="64"
    max_val="512"
    name="DrawDistance"
    top_delta="34"
    width="428" />
  <text
    type="string"
    length="1"
    follows="left|top"
    height="12"
    layout="topleft"
    left_delta="425"
    name="DrawDistanceMeterText2"
    top_delta="0"
    width="128">
     m
  </text>

  <button
  height="23"
  label="Automatic adjustments settings"
  layout="topleft"
  left="30"
  name="AutoAdjustmentsButton"
  top_delta="30"
  width="200">
    <button.commit_callback
      function="Pref.AutoAdjustments"/>
  </button>

    <text
      type="string"
      length="1"
      follows="left|top"
      height="16"
      layout="topleft"
      left="30"
      top_delta="42"
      width="128"
      name="AvatarComplexityModeLabel"
      text_readonly_color="LabelDisabledColor">
        Avatar display:
    </text>
    <combo_box
     control_name="RenderAvatarComplexityMode"
     height="23"
     layout="topleft"
     left_delta="130"
     top_delta="-4"
     name="AvatarComplexityMode"
     width="150">
        <combo_box.item
         label="Limit by complexity"
         name="0"
         value="0"/>
        <combo_box.item
         label="Always show friends"
         name="1"
         value="1"/>
        <combo_box.item
         label="Only show friends"
         name="2"
         value="2"/>
    </combo_box>
  
  <slider
    control_name="IndirectMaxComplexity"
    tool_tip="Controls at what point a visually complex avatar is drawn as a JellyDoll"
    follows="left|top"
    height="16"
    initial_value="101"
    increment="1"
    label="Avatar maximum complexity:"
    label_width="187"
    layout="topleft"
    left="30"
    min_val="1"
    max_val="101"
    name="IndirectMaxComplexity"
    show_text="false"
    top_delta="28"
    width="394">
    <slider.commit_callback
      function="Pref.UpdateIndirectMaxComplexity"
      parameter="IndirectMaxComlexityText" />
  </slider>
  <text
    type="string"
    length="1"
    follows="left|top"
    height="16"
    layout="topleft"
    top_delta="0"
    left_delta="398"
    text_readonly_color="LabelDisabledColor"
    name="IndirectMaxComplexityText"
    width="65">
       0
  </text>

  <slider
    control_name="IndirectMaxNonImpostors"
    name="IndirectMaxNonImpostors"
    decimal_digits="0"
    increment="1"
    initial_value="12"
    show_text="false"
    min_val="1"
    max_val="66"
    label="Maximum number of animated avatars:"
    follows="left|top"
    layout="topleft"
    height="16"
    label_width="240"
    left="30"
    top_delta="20"
    width="394">
      <slider.commit_callback
        function="Pref.UpdateIndirectMaxNonImpostors"
        parameter="IndirectNonImpostorsText" />
  </slider>
  <text
    type="string"
    length="1"
    follows="left|top"
    height="16"
    layout="topleft"
    top_delta="0"
    left_delta="398"
    text_readonly_color="LabelDisabledColor"
    name="IndirectMaxNonImpostorsText"
    width="65">
      0
  </text> 
    
  <button
    height="23"
    label="Exceptions..."
    layout="topleft"
    left="48"
    name="RenderExceptionsButton"
    top_delta="24"
    width="100">
    <button.commit_callback
      function="Pref.RenderExceptions"/>
  </button>

  <slider
    control_name="RenderExposure"
    enabled_control="RenderDisableVintageMode"
    decimal_digits="1"
    follows="left|top"
    height="16"
    increment="0.1"
    initial_value="160"
    label="Brightness (exposure)"
    label_width="187"
    layout="topleft"
    left="30"
    min_val="0.5"
    max_val="4.0"
    name="RenderExposure"
    show_text="true"
    top_pad="14"
    width="424">
  </slider>

<!-- End of Basic Settings block -->

  <button
    follows="top|left"
    height="23"
    label="Save settings as a preset..."
    layout="topleft"
    left="10"
    name="PrefSaveButton"
    top="310"
    width="200">
    <button.commit_callback
      function="Pref.PrefSave"
      parameter="graphic" />
  </button>

  <button
    follows="top|left"
    height="23"
    label="Load preset..."
    layout="topleft"
    left_pad="10"
    name="PrefLoadButton"
    top_delta="0"
    width="115">
    <button.commit_callback
      function="Pref.PrefLoad"
	  parameter="graphic"/>
  </button>

  <button
    follows="top|left"
    height="23"
    label="Delete preset..."
    layout="topleft"
    left_pad="10"
    name="PrefDeleteButton"
    top_delta="0"
    width="115">
    <button.commit_callback
      function="Pref.PrefDelete"
	  parameter="graphic"/>
  </button>

  <button
    follows="top|left"
    height="23"
    label="Reset to recommended settings"
    layout="topleft"
    left="10"
    name="Defaults"
    top_delta="65"
    width="210">
    <button.commit_callback
      function="Pref.HardwareDefaults" />
  </button>

  <button
    follows="top|left"
    height="23"
    label="Advanced Settings..."
    layout="topleft"
    left_pad="10"
    name="AdvancedSettings"
    top_delta="0"
    width="200">
    <button.commit_callback
      function="Pref.Advanced"
      parameter="advanced" />
  </button>

  </panel>

  <panel
    follows="all"
    height="410"
    label="Skin Scattering"
    layout="topleft"
    name="graphics_skin_scattering_panel"
    width="517">
    <scroll_container name="SkinScatteringScroll" follows="all" layout="topleft"
      left="0" top="0" width="517" height="410" reserve_scroll_corner="false">
    <panel name="SkinScatteringContent" follows="left|top" layout="topleft"
      left="0" top="0" width="495" height="500">

    <text
      follows="left|top|right"
      height="34"
      layout="topleft"
      left="20"
      name="SkinScatteringDescription"
      top="8"
      width="470"
      word_wrap="true">
      Softens lighting on surfaces tagged [sss] in the linkset description (or attachment name when no description is available).
    </text>

    <check_box
      control_name="BoxxySSSEnabled"
      height="20"
      label="Enable skin subsurface scattering"
      layout="topleft"
      left="30"
      name="BoxxySSSEnabled"
      top="48"
      tool_tip="Apply skin lighting to visible [sss]-tagged surfaces, including test prims. The default avatar mesh is excluded."
      width="360">
      <check_box.commit_callback function="Pref.RenderOptionUpdate" />
    </check_box>

    <text
      follows="left|top"
      height="20"
      layout="topleft"
      left="30"
      name="BoxxySSSModeLabel"
      top="81"
      width="180">
      Scattering method:
    </text>
    <combo_box
      control_name="BoxxySSSMode"
      enabled_control="BoxxySSSEnabled"
      height="23"
      layout="topleft"
      left="210"
      name="BoxxySSSMode"
      top="77"
      tool_tip="Combined adds adjustable wrap and warm backlighting to screen diffusion. Wrapped lighting has the lowest GPU cost."
      width="270">
      <combo_box.item
        label="Wrapped lighting (faster)"
        name="WrappedLighting"
        value="0" />
      <combo_box.item
        label="Screen diffusion (quality)"
        name="ScreenDiffusion"
        value="1" />
      <combo_box.item label="Combined (diffusion + light)" name="CombinedScattering" value="2" />
      <combo_box.commit_callback function="Pref.RenderOptionUpdate" />
    </combo_box>

    <slider
      control_name="BoxxySSSStrength"
      decimal_digits="2"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Strength:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSStrength"
      show_text="true"
      top="111"
      tool_tip="Controls how strongly skin lighting wraps and diffuses."
      width="450" />

    <slider
      control_name="BoxxySSSDepth"
      decimal_digits="3"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="0.001"
      label="Diffusion depth (m):"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="0.03"
      min_val="0.001"
      name="BoxxySSSDepth"
      show_text="true"
      top="139"
      tool_tip="Sets the diffusion radius in meters for Screen diffusion and Combined modes."
      width="450" />

    <slider
      control_name="BoxxySSSWarmth"
      decimal_digits="2"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Scattering warmth:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSWarmth"
      show_text="true"
      top="167"
      tool_tip="Controls the warmth of the scattering color response."
      width="450" />

    <slider
      control_name="BoxxySSSMaxDistance"
      decimal_digits="0"
      enabled_control="BoxxySSSEnabled"
      follows="left|top"
      height="20"
      increment="1"
      label="Maximum distance (m):"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="128"
      min_val="1"
      name="BoxxySSSMaxDistance"
      show_text="true"
      top="195"
      tool_tip="Limits skin scattering to nearby affected surfaces to control GPU cost."
      width="450" />

    <slider
      control_name="BoxxySSSWrapAmount"
      decimal_digits="2"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Combined wrap:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSWrapAmount"
      show_text="true"
      top="223"
      tool_tip="Adds wrapped lighting in Combined mode. Zero leaves diffusion and transmission."
      width="450" />

    <slider
      control_name="BoxxySSSTransmission"
      decimal_digits="2"
      follows="left|top"
      height="20"
      increment="0.05"
      label="Transmission:"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="1.0"
      min_val="0.0"
      name="BoxxySSSTransmission"
      show_text="true"
      top="251"
      tool_tip="Adds warm light from behind the skin in Combined mode. Uses existing light colors, attenuation and shadows."
      width="450" />

    <slider
      control_name="BoxxySSSThickness"
      decimal_digits="1"
      follows="left|top"
      height="20"
      increment="0.5"
      label="Thickness estimate (mm):"
      label_width="180"
      layout="topleft"
      left="30"
      max_val="20.0"
      min_val="0.5"
      name="BoxxySSSThickness"
      show_text="true"
      top="279"
      tool_tip="Combined mode optical thickness estimate, tapered toward silhouettes. Lower values transmit more light. This does not measure the mesh."
      width="450" />

    <check_box
      control_name="BoxxySSSAutoDetect"
      enabled_control="BoxxySSSEnabled"
      height="20"
      label="Detect mesh body parts on all avatars"
      layout="topleft"
      left="30"
      name="BoxxySSSAutoDetect"
      top="311"
      tool_tip="Detect your own and other avatars' mesh attachments when the linkset root name contains any whitelist term. Names load gradually for visible attachments within Maximum distance."
      width="420" />

    <check_box
      control_name="BoxxySSSShowMask"
      enabled_control="BoxxySSSEnabled"
      height="20"
      label="Highlight affected surfaces"
      layout="topleft"
      left="30"
      name="BoxxySSSShowMask"
      top="337"
      tool_tip="Highlight every surface currently receiving skin scattering for setup and testing."
      width="420" />

    <text name="SSSWhitelistLabel" follows="left|top" layout="topleft"
      left="30" top="367" width="440" height="18">Automatic detection whitelist:</text>
    <line_editor name="BoxxySSSWhitelist" control_name="BoxxySSSWhitelist"
      enabled_control="BoxxySSSAutoDetect" follows="left|top" layout="topleft"
      left="30" top="390" width="450" height="23" max_length_bytes="2048"
      tool_tip="Separate terms with commas. Matching ignores case and finds terms anywhere in the attachment root name. Empty terms are ignored." />
    <text name="SSSWhitelistHelp" follows="left|top" layout="topleft"
      left="30" top="419" width="450" height="28" word_wrap="true">
      Comma-separated terms; body also matches eBODY. Clear the list to use only explicit [sss] tags.
    </text>

    <text
      follows="left|top|right"
      height="35"
      layout="topleft"
      left="30"
      name="SkinScatteringPerformanceNote"
      text_color="LtGray_50"
      top="453"
      width="440"
      word_wrap="true">
      Opaque and alpha-masked surfaces only. Combined uses an approximate thickness; reduce it for stronger transmission.
    </text>

    </panel>
    </scroll_container>
  </panel>
  </tab_container>

</panel>
