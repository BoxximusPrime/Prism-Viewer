<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 save_rect="true"
 height="655"
 width="483"
 name="inventory_settings"
 title="INVENTORY SETTINGS">
 <scroll_container
  name="settings_scroll"
  layout="topleft"
  follows="all"
  left="0"
  top="18"
  width="483"
  height="637"
  opaque="false"
  border_visible="false">
 <panel
  name="settings_content"
  layout="topleft"
  follows="left|top"
  left="0"
  top="0"
  width="467"
  height="755">
 <icon
  follows="top|left"
  height="18"
  image_name="Multi_Folder_Mode"
  layout="topleft"
  left="18"
  mouse_opaque="true"
  name="multi_folder_icon"
  top="20"
  width="18" />
 <text
   type="string"
   length="1"
   follows="left|top|right"
   height="13"
   layout="topleft"
   left_pad="12"
   top_delta="2"
   name="multi_folder_txt"
   text_color="White"
   width="300">
   Double-click on folder in multi-folder view:
 </text>
 <radio_group
  control_name="MultiModeDoubleClickFolder"
  follows="left|top"
  top_pad="8"
  layout="topleft"
  left="60"
  width="300"
  height="66"
  name="multi_double_click_setting">
     <radio_item
      height="18"
      label="Expands &amp; collapses folder"
      label_text.text_color="White"
      follows="left|top"
      layout="topleft"
      name="0"
      width="200"/>
     <radio_item
      height="18"
      follows="left|top"
      label="Opens a new window"
      label_text.text_color="White"
      layout="topleft"
      left_delta="0"
      name="1"
      top_pad ="3"
      width="200" />
     <radio_item
      height="18"
      follows="left|top"
      label="Switches view"
      label_text.text_color="White"
      layout="topleft"
      left_delta="0"
      name="2"
      top_pad ="3"
      width="200" />
 </radio_group>
 <text
  type="string"
  length="1"
  follows="left|top|right"
  height="13"
  layout="topleft"
  left="60"
  top_pad="6"
  name="multi_alt_click_label"
  text_color="White"
  width="300">
  Alt+click on folder:
 </text>
 <combo_box
  control_name="MultiModeAltClickFolder"
  follows="left|top"
  height="24"
  layout="topleft"
  left="60"
  top_pad="3"
  name="multi_alt_click_setting"
  width="300">
   <combo_box.item label="Expands &amp; collapses folder" name="0" value="0"/>
   <combo_box.item label="Opens a new window" name="1" value="1"/>
   <combo_box.item label="Switches view" name="2" value="2"/>
   <combo_box.item label="Expands &amp; collapses all subfolders" name="3" value="3"/>
 </combo_box>
 <icon
  follows="top|left"
  height="18"
  image_name="Single_Folder_Mode"
  layout="topleft"
  left="18"
  mouse_opaque="true"
  name="single_folder_icon"
  top_pad="19"
  width="18" />
 <text
   type="string"
   length="1"
   follows="left|top|right"
   height="13"
   layout="topleft"
   left_pad="12"
   top_delta="2"
   name="single_folder_txt"
   text_color="White"
   width="300">
   Double-click on folder in single-folder view:
 </text>
 <radio_group
  control_name="SingleModeDoubleClickOpenWindow"
  follows="left|top"
  top_pad="8"
  layout="topleft"
  left="60"
  width="300"
  height="44"
  name="single_double_click_setting">
     <radio_item
      height="18"
      label="Stays in current window"
      label_text.text_color="White"
      follows="left|top"
      layout="topleft"
      name="false"
      width="200"/>
     <radio_item
      height="18"
      follows="left|top"
      label="Opens a new window"
      label_text.text_color="White"
      layout="topleft"
      left_delta="0"
      name="true"
      top_pad ="3"
      width="200" />
 </radio_group>
 <text
  type="string"
  length="1"
  follows="left|top|right"
  height="13"
  layout="topleft"
  left="60"
  top_pad="6"
  name="single_alt_click_label"
  text_color="White"
  width="300">
  Alt+click on folder:
 </text>
 <combo_box
  control_name="SingleModeAltClickFolder"
  follows="left|top"
  height="24"
  layout="topleft"
  left="60"
  top_pad="3"
  name="single_alt_click_setting"
  width="300">
   <combo_box.item label="Selects folder" name="0" value="0"/>
   <combo_box.item label="Stays in current window" name="1" value="1"/>
   <combo_box.item label="Opens a new window" name="2" value="2"/>
 </combo_box>
  <icon
   follows="top|left"
   height="15"
   image_name="Icon_Pointer"
   layout="topleft"
   left="20"
   mouse_opaque="true"
   name="single_folder_icon"
   top_pad="20"
   width="15" />
 <text
   type="string"
   length="1"
   follows="left|top|right"
   height="13"
   layout="topleft"
   left_pad="13"
   name="find_original_txt"
   text_color="White"
   top_delta="1"
   width="310">
   Clicking on "Show in inventory" or "Find original"
 </text>
 <radio_group
  control_name="FindOriginalOpenWindow"
  follows="left|top"
  top_pad="8"
  layout="topleft"
  left="60"
  width="300"
  height="44"
  name="find_original_settings">
     <radio_item
      height="18"
      label="Shows item in main inventory window"
      label_text.text_color="White"
      follows="left|top"
      layout="topleft"
      name="false"
      width="200"/>
     <radio_item
      height="18"
      follows="left|top"
      label="Opens a new single-folder window"
      label_text.text_color="White"
      layout="topleft"
      left_delta="0"
      name="true"
      top_pad ="3"
      width="200" />
 </radio_group>
  <icon
   follows="top|left"
   height="18"
   image_name="Inv_Favorite_Star_Full"
   layout="topleft"
   left="18"
   mouse_opaque="true"
   name="favorites_icon"
   top_pad="19"
   width="18" />
  <text
   type="string"
   length="1"
   layout="topleft"
   follows="left|top|right"
   height="13"
   left_pad="12"
   top_delta="2"
   name="favorites_txt"
   text_color="White"
   width="300">
   Favorites
  </text>
  <check_box
   control_name="InventoryFavoritesUseStar"
   layout="topleft"
   follows="left|top"
   top_pad="8"
   left="60"
   width="300"
   height="18"
   label="Star on favorite items"
   name="favorite_star"
   label_text.text_color="White"
   initial_value="false"/>
  <check_box
   control_name="InventoryFavoritesUseHollowStar"
   follows="left|top"
   top_pad="5"
   layout="topleft"
   left="60"
   width="150"
   height="18"
   label="Star on folders containing a favorite"
   name="favorite_hollow_star"
   label_text.text_color="White"
   initial_value="false"/>
  <check_box
   control_name="InventoryFavoritesColorText"
   follows="left|top"
   top_pad="5"
   layout="topleft"
   left="60"
   width="150"
   height="18"
   label="Colored text"
   name="favorites_color"
   label_text.text_color="White"
   initial_value="false"/>
  <color_swatch
   can_apply_immediately="true"
   follows="left|top"
   layout="topleft"
   height="24"
   label_height="0"
   left_pad="40"
   name="favorites_swatch"
   top_delta="-6"
   width="44" >
    <color_swatch.init_callback
     function="ScriptPref.getUIColor"
     parameter="InventoryFavoriteColor" />
    <color_swatch.commit_callback
     function="ScriptPref.applyUIColor"
     parameter="InventoryFavoriteColor" />
  </color_swatch>
  <icon
   follows="top|left"
   height="18"
   image_name="Inv_Object"
   layout="topleft"
   left="18"
   mouse_opaque="true"
   name="obj_icon"
   top_pad="19"
   width="18" />
  <text
   type="string"
   length="1"
   follows="left|top|right"
   height="13"
   layout="topleft"
   left_pad="12"
   top_delta="2"
   name="avatar_attachment_action"
   text_color="White"
   width="380">
   Pressing enter or double clicking on an avatar attachment
  </text>
  <combo_box
   control_name="InventoryAddAttachmentBehavior"
   layout="topleft"
   follows="left|top"
   top_pad="8"
   height="24"
   left="60"
   name="attach_combo"
   width="300">
    <combo_box.item
      label="Adds attachment (recommended)"
      name="0"
      value="0"/>
    <combo_box.item
      label="Wear (removes attachment at that point)"
      name="1"
      value="1"/>
  </combo_box>
  <text
   type="string"
   length="1"
   follows="left|top|right"
   height="18"
   layout="topleft"
   left="18"
   top_pad="22"
   name="priority_helper_label"
   text_color="White"
   width="430">
   Attachment folder helper (50 items max)
  </text>
  <text
   type="string"
   length="1"
   follows="left|top|right"
   height="16"
   layout="topleft"
   left="60"
   top_pad="5"
   name="priority_keywords_label"
   text_color="White"
   width="380">
   Item keywords (comma separated) and text color:
  </text>
  <line_editor
   control_name="InventoryDemoHelperKeywords"
   follows="left|top|right"
   height="23"
   layout="topleft"
   left="60"
   top_pad="5"
   name="priority_keywords"
   width="330" />
  <color_swatch
   can_apply_immediately="true"
   follows="left|top"
   layout="topleft"
   height="23"
   label_height="0"
   left_pad="16"
   name="priority_swatch"
   tooltip="Item keyword text color"
   top_delta="0"
   width="44">
    <color_swatch.init_callback
     function="ScriptPref.getUIColor"
     parameter="InventoryPriorityColor" />
    <color_swatch.commit_callback
     function="ScriptPref.applyUIColor"
     parameter="InventoryPriorityColor" />
  </color_swatch>
  <text
   type="string"
   length="1"
   follows="left|top|right"
   height="18"
   layout="topleft"
   left="18"
   top_pad="22"
   name="folder_highlight_label"
   text_color="White"
   width="430">
   Folder keyword highlights
  </text>
  <text
   type="string"
   length="1"
   follows="left|top|right"
   height="16"
   layout="topleft"
   left="60"
   top_pad="5"
   name="folder_keywords_label"
   text_color="White"
   width="390">
   Folder keywords (comma separated) and box color:
  </text>
  <line_editor
   control_name="InventoryFolderHighlightKeywords"
   follows="left|top|right"
   height="23"
   layout="topleft"
   left="60"
   top_pad="5"
   name="folder_keywords"
   tooltip="Highlight matching parts of folder names, ignoring case. For example: demo, legacy"
   width="330" />
  <color_swatch
   can_apply_immediately="true"
   follows="left|top"
   layout="topleft"
   height="23"
   label_height="0"
   left_pad="16"
   name="folder_keyword_swatch"
   tooltip="Folder keyword background color"
   top_delta="0"
   width="44">
    <color_swatch.init_callback
     function="ScriptPref.getUIColor"
     parameter="InventoryFolderKeywordColor" />
    <color_swatch.commit_callback
     function="ScriptPref.applyUIColor"
     parameter="InventoryFolderKeywordColor" />
  </color_swatch>
 </panel>
 </scroll_container>
</floater>
