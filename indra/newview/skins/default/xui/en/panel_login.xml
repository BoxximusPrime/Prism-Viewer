<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 follows="all"
 height="768"
 layout="topleft"
 name="panel_login"
 focus_root="true"
 background_visible="false"
 width="1024">
  <panel.string name="forgot_password_url">http://secondlife.com/account/request.php</panel.string>
  <panel.string name="sign_up_url">https://join.secondlife.com/</panel.string>

  <layout_stack
   follows="all"
   layout="topleft"
   orientation="horizontal"
   border_size="0"
   animate="false"
   left="0"
   top="0"
   width="1024"
   height="768">
    <layout_panel auto_resize="true" user_resize="false" background_visible="false" min_width="0" width="1" />
    <layout_panel
     auto_resize="false"
     user_resize="false"
     background_visible="false"
     width="400"
     height="768">
      <layout_stack
       follows="all"
       layout="topleft"
       orientation="vertical"
       border_size="0"
       animate="false"
       left="0"
       top="0"
       width="400"
       height="768">
        <layout_panel auto_resize="true" user_resize="false" background_visible="false" min_height="0" height="1" />
        <layout_panel
         auto_resize="false"
         user_resize="false"
         background_visible="false"
         width="400"
         height="290">
          <icon
           follows="left|top"
           layout="topleft"
           name="boxxy_login_shadow_soft"
           image_name="Rounded_Square"
           color="Black_25"
           mouse_opaque="false"
           left="90"
           top="257"
           width="220"
           height="18" />
          <icon
           follows="left|top"
           layout="topleft"
           name="boxxy_login_shadow_core"
           image_name="Rounded_Square"
           color="Black_50"
           mouse_opaque="false"
           left="130"
           top="261"
           width="140"
           height="10" />
          <icon
           follows="left|top"
           layout="topleft"
           name="boxxy_login_brand"
           image_name="startup_logo"
           mouse_opaque="false"
           left="72"
           top="2"
           width="256"
           height="256" />
        </layout_panel>
        <layout_panel
         auto_resize="false"
         user_resize="false"
         background_visible="true"
         background_opaque="false"
         bg_alpha_color="Black_50"
         width="400"
         height="300">
          <combo_box
           follows="left|top"
           layout="topleft"
           name="username_combo"
           allow_text_entry="true"
           label="Username"
           tool_tip="Username"
           combo_editor.font="SansSerifLarge"
           combo_editor.commit_on_focus_lost="false"
           combo_editor.prevalidator="ascii"
           max_chars="128"
           left="30"
           top="30"
           width="340"
           height="38">
            <combo_box.combo_button
             image_overlay="ComboButton_Arrow"
             image_overlay_right_delta="10"
             image_unselected="ComboButton_Transparent"
             hover_glow_amount="0"
             image_selected="ComboButton_Transparent"
             image_disabled="ComboButton_Transparent" />
            <combo_box.combo_editor
             background_image="TextField_Transparent"
             background_image_disabled="TextField_Transparent"
             background_image_focused="TextField_Transparent"
             draw_focus_border="false"
             text_pad_left="12"
             bg_image_always_focused="true" />
          </combo_box>
          <line_editor
           follows="left|top"
           layout="topleft"
           name="password_edit"
           label="Password"
           left="30"
           top="91"
           width="340"
           height="38"
           max_length_chars="16"
           text_pad_left="12"
           bg_image_always_focused="true"
           font="SansSerifLarge"
           is_password="true"
           select_on_focus="true"
           draw_focus_border="false"
           commit_on_focus_lost="false" />
          <check_box
           name="remember_name"
           label="Remember username"
           label_text.text_color="LtGray"
           font="SansSerifSmall"
           left="30"
           top="139"
           width="164"
           height="24" />
          <check_box
           name="remember_password"
           control_name="RememberPassword"
           label="Remember password"
           label_text.text_color="LtGray"
           font="SansSerifSmall"
           left="206"
           top="139"
           width="164"
           height="24" />
          <layout_stack
           name="login_stack"
           orientation="horizontal"
           border_size="12"
           animate="false"
           left="30"
           top="178"
           width="340"
           height="38">
            <layout_panel name="location_panel" auto_resize="true" user_resize="false" min_width="164" width="164" height="38">
              <combo_box
               name="start_location_combo"
               control_name="NextLoginLocation"
               allow_text_entry="true"
               label="Start location"
               font="SansSerifLarge"
               combo_editor.font="SansSerifLarge"
               combo_editor.text_pad_left="12"
               follows="all"
               left="0"
               top="0"
               width="164"
               height="38">
                <combo_box.combo_button
                 image_unselected="ComboButton_Transparent"
                 image_selected="ComboButton_Transparent"
                 image_disabled="ComboButton_Transparent"
                 image_overlay="ComboButton_Arrow" />
                <combo_box.item label="My last location" name="MyLastLocation" value="last" />
                <combo_box.item label="My home" name="MyHome" value="home" />
              </combo_box>
            </layout_panel>
            <layout_panel name="grid_panel" auto_resize="false" user_resize="false" width="164" height="38">
              <combo_box
               name="server_combo"
               allow_text_entry="false"
               label="Grid"
               font="SansSerifLarge"
               drop_down_button.font="SansSerifLarge"
               follows="all"
               left="0"
               top="0"
               width="164"
               height="38" />
            </layout_panel>
          </layout_stack>
          <button
           follows="left|top"
           image_unselected="Rounded_Square"
           image_selected="Rounded_Square"
           image_pressed="Rounded_Square"
           image_hover_unselected="Rounded_Square"
           image_color="AccentColor"
           label="Log in"
           label_color="Black"
           label_color_disabled="Black"
           font="SansSerifLarge"
           font.style="BOLD"
           name="connect_btn"
           draw_focus_border="false"
           hover_hand_cursor="true"
           enabled="true"
           left="30"
           top="233"
           width="340"
           height="38"
           pad_bottom="1" />
        </layout_panel>
        <layout_panel auto_resize="true" user_resize="false" background_visible="false" min_height="0" height="1" />
      </layout_stack>
    </layout_panel>
    <layout_panel auto_resize="true" user_resize="false" background_visible="false" min_width="0" width="1" />
  </layout_stack>

  <!-- Recovery and signup remain available elsewhere, but stay off this minimal screen. -->
  <text name="forgot_password_text" visible="false">Forgot password</text>
  <button name="sign_btn" visible="false" />
</panel>
