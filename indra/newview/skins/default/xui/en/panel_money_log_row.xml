<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 background_opaque="false"
 background_visible="true"
 bg_alpha_color="MoneyLogCreditBgColor"
 follows="left|right|top"
 height="68"
 layout="topleft"
 left="0"
 mouse_opaque="false"
 name="money_log_row"
 top="0"
 width="676">
    <layout_stack
     follows="all"
     height="68"
     left="0"
     name="columns"
     orientation="horizontal"
     top="0"
     width="676">
        <layout_panel
         auto_resize="true"
         height="68"
         layout="topleft"
         name="transaction_column"
         user_resize="false"
         width="338">
            <text
             follows="left|right|top"
             font="SansSerifLarge"
             font.style="BOLD"
             height="24"
             left="14"
             name="transaction"
             right="-12"
             top="10"
             use_ellipses="true"
             value="+ L$0 from Display Name" />
            <text
             follows="left|right|top"
             font="SansSerifSmall"
             height="18"
             left="14"
             name="username"
             right="-12"
             text_color="LabelTextColor"
             top="39"
             use_ellipses="true"
             value="username" />
        </layout_panel>
        <layout_panel
         auto_resize="true"
         height="68"
         layout="topleft"
         name="time_column"
         user_resize="false"
         width="338">
            <text
             follows="left|right|top"
             font="SansSerifLarge"
             font.style="BOLD"
             halign="right"
             height="24"
             left="12"
             name="relative_time"
             right="-14"
             top="10"
             value="0 seconds ago" />
            <text
             follows="left|right|top"
             font="SansSerifSmall"
             halign="right"
             height="18"
             left="12"
             name="date"
             right="-14"
             text_color="LabelTextColor"
             top="39"
             value="01/01/2026" />
        </layout_panel>
    </layout_stack>
</panel>
