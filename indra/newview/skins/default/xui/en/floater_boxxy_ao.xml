<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 positioning="centered"
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="560"
 min_height="520"
 min_width="740"
 width="820"
 layout="topleft"
 name="boxxy_ao"
 save_rect="true"
 single_instance="true"
 title="PRISM ANIMATION OVERRIDER">

  <check_box
   name="ao_enabled"
   label="Enable Animation Overrider"
   left="12"
   top="30"
   width="190"
   height="20" />

  <combo_box
   name="set_combo"
   left="12"
   top="57"
   width="255"
   height="24"
   tool_tip="Choose an animation set to edit" />
  <button
   name="activate_set"
   label="Activate"
   left_pad="6"
   width="72"
   height="24"
   tool_tip="Use this animation set now" />
  <button
   name="new_set"
   label="New Set"
   left_pad="6"
   width="72"
   height="24" />
  <button
   name="remove_set"
   label="Remove"
   left_pad="6"
   width="72"
   height="24" />
  <check_box
   name="override_sits"
   label="Override scripted sits"
   left_pad="10"
   width="155"
   height="20"
   tool_tip="When off, furniture-provided sit animations are left alone" />

  <text
   left="12"
   top="92"
   width="205"
   height="18"
   font.style="BOLD">
    Animation state
  </text>
  <text
   left="230"
   top="92"
   width="390"
   height="18"
   font.style="BOLD">
    Linked animations
  </text>

  <scroll_list
   name="state_list"
   left="12"
   top="112"
   width="205"
   bottom="-198"
   follows="left|top|bottom"
   multi_select="false">
    <scroll_list.columns name="state" label="State" dynamic_width="true" />
    <scroll_list.columns name="count" label="#" dynamic_width="false" width="28" />
  </scroll_list>

  <scroll_list
   name="animation_list"
   left="230"
   top="112"
   right="-12"
   bottom="-284"
   follows="all"
   multi_select="false">
    <scroll_list.columns name="playing" label="" dynamic_width="false" width="24" />
    <scroll_list.columns name="animation" label="Animation" dynamic_width="true" />
  </scroll_list>

  <button
   name="play_animation"
   follows="left|bottom"
   label="Play"
   left="230"
   bottom="-250"
   width="58"
   height="24" />
  <button
   name="move_up"
   follows="left|bottom"
   label="Move Up"
   left_pad="6"
   width="70"
   height="24" />
  <button
   name="move_down"
   follows="left|bottom"
   label="Move Down"
   left_pad="6"
   width="80"
   height="24" />
  <button
   name="remove_animation"
   follows="left|bottom"
   label="Remove Link"
   left_pad="6"
   width="92"
   height="24"
   tool_tip="Remove only the AO link; the original animation remains in Inventory" />
  <button
   name="previous_animation"
   follows="left|bottom"
   label="Previous"
   left_pad="14"
   width="68"
   height="24" />
  <button
   name="next_animation"
   follows="left|bottom"
   label="Next"
   left_pad="6"
   width="58"
   height="24" />

  <view_border
   name="drop_border"
   left="230"
   bottom="-196"
   right="-12"
   height="38"
   follows="left|right|bottom" />
  <text
   name="drop_hint"
   left="242"
   bottom="-205"
   right="-118"
   height="24"
   follows="left|right|bottom"
   valign="center"
   text_color="LabelTextColor">
    Drag animations here from Inventory.
  </text>
  <button
   name="open_inventory"
   label="Open Inventory"
   right="-22"
   bottom="-205"
   width="94"
   height="24"
   follows="right|bottom" />

  <panel
   name="cycle_panel"
   left="230"
   bottom="-146"
   right="-12"
   height="36"
   follows="left|right|bottom"
   background_visible="true"
   bg_alpha_color="DkGray2">
    <check_box
     name="cycle_enabled"
     label="Timed cycle"
     left="10"
     top="9"
     width="95"
     height="20" />
    <text
     left_pad="8"
     top_delta="2"
     width="48"
     height="18">
      Every
    </text>
    <spinner
     name="cycle_seconds"
     left_pad="0"
     top_delta="-3"
     width="72"
     height="22"
     min_val="1"
     max_val="3600"
     increment="1"
     decimal_digits="1"
     initial_value="30" />
    <text
     left_pad="5"
     top_delta="3"
     width="55"
     height="18">
      seconds
    </text>
    <check_box
     name="cycle_randomize"
     label="Random order"
     left_pad="10"
     top_delta="-2"
     width="110"
     height="20" />
  </panel>

  <text
   left="12"
   bottom="-144"
   width="205"
   height="48"
   follows="left|bottom"
   word_wrap="true"
   text_color="LabelDisabledColor">
    Inventory: #Prism/#AO
    (or your existing #Boxxy/#AO).
  </text>
  <panel name="transfer_panel" left="12" right="-12" bottom="-12" height="104"
   follows="left|right|bottom" layout="topleft" background_visible="true" bg_alpha_color="DkGray2">
    <text left="10" top="8" width="300" height="18" font.style="BOLD">Import and export</text>
    <button name="import_ao" label="Import from Inventory" left="10" top="31" width="160" height="24"
     tool_tip="Open Inventory, then drag a set folder from #Firestorm/#AO or an AO notecard into this window." />
    <button name="export_firestorm" label="Export to Firestorm" left_pad="8" width="150" height="24"
     tool_tip="Create a new set in #Firestorm/#AO, preserving animation order, cycling, randomization and sit override." />
    <button name="export_notecard" label="Export Notecard" left_pad="8" width="135" height="24"
     tool_tip="Create a ZHAO-II notecard and animation links in a new Inventory folder. This format stores animation assignments only." />
    <text name="transfer_status" left="10" top="61" right="-10" height="18" follows="left|top|right">
      Drop one Firestorm set folder or a ZHAO-II / Oracul notecard into this window to import.
    </text>
    <text left="10" top="82" right="-10" height="18" follows="left|top|right" text_color="LabelDisabledColor">
      Transfers link animations already in your Inventory; they do not export animation files.
    </text>
  </panel>
</floater>
