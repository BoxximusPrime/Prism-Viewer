<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Standalone control specimen; no settings, callbacks or application panels.
     Copy this wrapper when adopting the style, replacing the three empty panels.
     The native tab_top_frame keeps the fading border attached to this control. -->
<panel name="prism_tabs" width="640" height="200" layout="topleft"
       follows="all" background_visible="false" border="false">
    <tab_container name="tabs" left="0" top="0" width="640" height="200"
                   layout="topleft" follows="all" tab_position="top"
                   tab_top_frame="Prism_Tab_Frame"
                   tab_height="32" tab_min_width="112" tab_max_width="180"
                   label_pad_bottom="1" label_pad_left="8"
                   font="SansSerif" font.size="Small" halign="center"
                   background_visible="false" border="false">
        <tab_button image_hover_unselected="Prism_Tab_Hover"
                    image_hover_selected="Prism_Tab_Selected_Hover"
                    image_pressed="Prism_Tab_Pressed"
                    image_pressed_selected="Prism_Tab_Pressed"
                    image_disabled="Prism_Tab_Disabled"
                    image_disabled_selected="Prism_Tab_Selected_Disabled"
                    image_color="White" image_color_disabled="White"
                    label_color="0.76 0.77 0.81 1"
                    label_color_selected="0.96 0.83 0.64 1"
                    label_color_disabled="0.39 0.39 0.43 1"
                    label_color_disabled_selected="0.49 0.44 0.36 1"
                    hover_glow_amount="0" label_shadow="false" />
        <first_tab tab_top_image_unselected="Prism_Tab_Off" tab_top_image_selected="Prism_Tab_Selected" />
        <middle_tab tab_top_image_unselected="Prism_Tab_Off" tab_top_image_selected="Prism_Tab_Selected" />
        <last_tab tab_top_image_unselected="Prism_Tab_Off" tab_top_image_selected="Prism_Tab_Selected" />
        <panel name="general" label="General" background_visible="false" border="false" />
        <panel name="object" label="Object" background_visible="false" border="false" />
        <panel name="features" label="Features" background_visible="false" border="false" />
    </tab_container>
</panel>
