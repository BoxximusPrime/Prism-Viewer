<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Texture">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">Colore</text>
			<color_swatch name="colorswatch" tool_tip="Clicca per aprire il selettore dei colori" />
			<text name="color trans">Trasparenza %</text>
			<text name="glow label">Bagliore</text>
			<check_box name="checkbox fullbright" label="Luminosità massima" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Materiali" />
				<combo_box.item name="Media" value="Media" label="Multimedia" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Texture (diffusa)" ><radio_item.check_button label="Texture (diffusa)" label_selected="Texture (diffusa)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Irregolarità (normale)" ><radio_item.check_button label="Irregolarità (normale)" label_selected="Irregolarità (normale)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Lucentezza (speculare)" ><radio_item.check_button label="Lucentezza (speculare)" label_selected="Lucentezza (speculare)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="Blocca ripetizione" tool_tip="Regola tutte le ripetizioni delle mappe contemporaneamente" />
			<texture_picker name="texture control" label="Texture" tool_tip="Clicca per scegliere una fotografia" />
			<text name="label alphamode">Modalità Alfa</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Nessuno" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="Miscelazione Alfa" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="Mascheratura Alfa" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Mascheratura emissiva" />
			</combo_box>
			<text name="label maskcutoff">Limite mascheratura</text>
			<texture_picker name="bumpytexture control" label="Texture" tool_tip="Clicca per scegliere una fotografia" />
			<text name="label bumpiness">Irregolarità</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Nessuno" />
				<combo_box.item name="Brightness" value="Brightness" label="Luminosità" />
				<combo_box.item name="Darkness" value="Darkness" label="Oscurità" />
				<combo_box.item name="woodgrain" value="woodgrain" label="venatura" />
				<combo_box.item name="bark" value="bark" label="corteccia" />
				<combo_box.item name="bricks" value="bricks" label="mattoni" />
				<combo_box.item name="checker" value="checker" label="scacchiera" />
				<combo_box.item name="concrete" value="concrete" label="cemento" />
				<combo_box.item name="crustytile" value="crustytile" label="incrostatura" />
				<combo_box.item name="cutstone" value="cutstone" label="gemma" />
				<combo_box.item name="discs" value="discs" label="dischi" />
				<combo_box.item name="gravel" value="gravel" label="ciottoli" />
				<combo_box.item name="petridish" value="petridish" label="batteri" />
				<combo_box.item name="siding" value="siding" label="rivestimento" />
				<combo_box.item name="stonetile" value="stonetile" label="lastricato" />
				<combo_box.item name="suction" value="suction" label="suzione" />
				<combo_box.item name="weave" value="weave" label="trama" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Texture" tool_tip="Clicca per scegliere una fotografia" />
			<text name="label shininess">Lucentezza</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Nessuna" />
				<combo_box.item name="Low" value="Low" label="Bassa" />
				<combo_box.item name="Medium" value="Medium" label="Media" />
				<combo_box.item name="High" value="High" label="Alta" />
			</combo_box>
			<text name="label glossiness">Patinatura</text>
			<text name="label environment">Ambiente</text>
			<text name="label shinycolor">Colore</text>
			<color_swatch name="shinycolorswatch" tool_tip="Clicca per aprire il selettore dei colori" />
			<text name="media_info">L'URL dell'eventuale elemento multimediale selezionato va qui</text>
			<button name="add_media" label="Scegli..." tool_tip="Aggiungi elemento multimediale" />
			<button name="delete_media" label="Rimuovi" tool_tip="Cancella questa texture dell'elemento multimediale" />
			<button name="button align" label="Alllinea" label_selected="Allinea elmento multimediale" tool_tip="Allinea texture dell'elemento multimediale (il caricamento deve prima essere completato)" />
			<text name="tex gen">Mappatura</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="Predefinita" />
				<combo_box.item name="Planar" value="Planar" label="Planare" />
			</combo_box>
			<spinner name="TexScaleU" label="Scala orizzontale" />
			<spinner name="TexScaleV" label="Scala veritcale" />
			<spinner name="rptctrl" label="Ripetizioni al metro" />
			<spinner name="TexRot" label="Gradi di rotazione" />
			<spinner name="TexOffsetU" label="Spostamento orizzontale" />
			<spinner name="TexOffsetV" label="Spostamento verticale" />
			<spinner name="bumpyScaleU" label="Scala orizzontale" />
			<spinner name="bumpyScaleV" label="Scala veritcale" />
			<spinner name="bumpyRot" label="Gradi di rotazione" />
			<spinner name="bumpyOffsetU" label="Spostamento orizzontale" />
			<spinner name="bumpyOffsetV" label="Spostamento verticale" />
			<spinner name="shinyScaleU" label="Scala orizzontale" />
			<spinner name="shinyScaleV" label="Scala veritcale" />
			<spinner name="shinyRot" label="Gradi di rotazione" />
			<spinner name="shinyOffsetU" label="Spostamento orizzontale" />
			<spinner name="shinyOffsetV" label="Spostamento verticale" />
			<check_box name="checkbox planar align" label="Allinea facce planari" tool_tip="Allinea le texture su tutte le facce selezionate con l’ultima faccia selezionata. È richiesta la mappatura planare delle texture." />
			<button name="button align textures" label="Alllinea" label_selected="Alllinea livelli di texture attuali" tool_tip="Alllinea livelli di texture attuali" />
		</panel>
	</scroll_container>
</panel>