			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="Domyślne" />
				<combo_box.item name="Planar" value="Planar" label="Planarne" />
			</combo_box>
			<spinner name="TexScaleU" label="Rozmiar poziomy" />
			<spinner name="TexScaleV" label="Rozmiar pionowy" />
			<spinner name="rptctrl" label="Powtórzenia na metr" />
			<spinner name="TexRot" label="Obrót w stopniach" />
			<spinner name="TexOffsetU" label="Wyrównanie poziome" />
			<spinner name="TexOffsetV" label="Wyrównanie pionowe" />
			<spinner name="bumpyScaleU" label="Rozmiar poziomy" />
			<spinner name="bumpyScaleV" label="Rozmiar pionowy" />
			<spinner name="bumpyRot" label="Obrót w stopniach" />
			<spinner name="bumpyOffsetU" label="Wyrównanie poziome" />
			<spinner name="bumpyOffsetV" label="Wyrównanie pionowe" />
			<spinner name="shinyScaleU" label="Rozmiar poziomy" />
			<spinner name="shinyScaleV" label="Rozmiar pionowy" />
			<spinner name="shinyRot" label="Obrót w stopniach" />
			<spinner name="shinyOffsetU" label="Wyrównanie poziome" />
			<spinner name="shinyOffsetV" label="Wyrównanie pionowe" />
			<check_box name="checkbox planar align" label="Równaj powierzchnie planarne" tool_tip="Wyrównuj tekstury na wszystkich wybranych powierzchniach z powierzchnią wybraną jako ostatnia. Wymaga planarnego mapowania tekstur." />
		</panel>
	</scroll_container>
</panel>