<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Tekstura">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="mapping_repeats_label">Powtórzenia na metr</text>
			<text name="color label">Kolor</text>
			<color_swatch name="colorswatch" tool_tip="Kliknij, aby wybrać kolor" />
			<text name="color trans">Przezroczystość</text>
			<text name="glow label">Blask</text>
			<check_box name="checkbox fullbright" label="Pełna jasność" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Materiały" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Tekstura (rozproszenie)" ><radio_item.check_button label="Tekstura (rozproszenie)" label_selected="Tekstura (rozproszenie)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Powierzchnia (normalny)" ><radio_item.check_button label="Powierzchnia (normalny)" label_selected="Powierzchnia (normalny)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Lśnienie (odbicie)" ><radio_item.check_button label="Lśnienie (odbicie)" label_selected="Lśnienie (odbicie)" /></radio_item>
			</radio_group>
			<texture_picker name="texture control" label="Tekstura" tool_tip="Kliknij, aby wybrać obraz" />
			<text name="label alphamode">Tryb alphy</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Brak" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="Przenikanie" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="Maskowanie" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Maska emisyjna" />
			</combo_box>
			<text name="label maskcutoff">Odcięcie maski</text>
			<texture_picker name="bumpytexture control" label="Tekstura" tool_tip="Kliknij, aby wybrać obraz" />
