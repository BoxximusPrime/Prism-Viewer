			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Bez mapowania" />
				<combo_box.item name="Brightness" value="Brightness" label="Rozjaśnienie" />
				<combo_box.item name="Darkness" value="Darkness" label="Przyciemnienie" />
				<combo_box.item name="woodgrain" value="woodgrain" label="Włókna drewna" />
				<combo_box.item name="bark" value="bark" label="Kora drzewa" />
				<combo_box.item name="bricks" value="bricks" label="Cegły" />
				<combo_box.item name="checker" value="checker" label="Plansza szachowa" />
				<combo_box.item name="concrete" value="concrete" label="Beton" />
				<combo_box.item name="crustytile" value="crustytile" label="Płytki/Kafelki" />
				<combo_box.item name="cutstone" value="cutstone" label="Kamień" />
				<combo_box.item name="discs" value="discs" label="Dysk CD" />
				<combo_box.item name="gravel" value="gravel" label="Żwir" />
				<combo_box.item name="petridish" value="petridish" label="Skamieliny" />
				<combo_box.item name="siding" value="siding" label="Brzeg" />
				<combo_box.item name="stonetile" value="stonetile" label="Płytka kamienna" />
				<combo_box.item name="stucco" value="stucco" label="Stiuk (gips ozdobny)" />
				<combo_box.item name="suction" value="suction" label="Ssawki" />
				<combo_box.item name="weave" value="weave" label="Fale" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Tekstura" tool_tip="Kliknij, aby wybrać obraz" />
			<text name="label shininess">Połysk</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Żaden" />
				<combo_box.item name="Low" value="Low" label="Niski" />
				<combo_box.item name="Medium" value="Medium" label="Średni" />
				<combo_box.item name="High" value="High" label="Wysoki" />
			</combo_box>
			<text name="label glossiness">Gładkość</text>
			<text name="label environment">Otoczenie</text>
			<text name="label shinycolor">Kolor</text>
			<color_swatch name="shinycolorswatch" tool_tip="Kliknij, aby wybrać kolor" />
