<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Doku">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">Renk</text>
			<color_swatch name="colorswatch" tool_tip="Renk seçiciyi açmak için tıklayın" />
			<text name="color trans">Saydamlık %</text>
			<text name="glow label">Parıltı</text>
			<check_box name="checkbox fullbright" label="Tam Parlak" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Malzemeler" />
				<combo_box.item name="Media" value="Media" label="Ortam" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Doku (yayılmış)" ><radio_item.check_button label="Doku (yayılmış)" label_selected="Doku (yayılmış)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Yumruluk (normal)" ><radio_item.check_button label="Yumruluk (normal)" label_selected="Yumruluk (normal)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Parıldama (yansıtan)" ><radio_item.check_button label="Parıldama (yansıtan)" label_selected="Parıldama (yansıtan)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="Kilit tekrarı" tool_tip="Tüm harita tekrarlarını aynı anda ayarla" />
			<texture_picker name="texture control" label="Doku" tool_tip="Bir resim seçmek için tıklayın" />
			<text name="label alphamode">Alfa modu</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Hiçbiri" />
