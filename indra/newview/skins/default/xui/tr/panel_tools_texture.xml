			<button name="add_media" label="Seç..." tool_tip="Ortam Ekle" />
			<button name="delete_media" label="Kaldır" tool_tip="Bu ortam dokusunu sil" />
			<button name="button align" label="Hizala" label_selected="Ortamı Hizala" tool_tip="Ortam dokusunu hizala (önce yüklenmelidir)" />
			<text name="tex gen">Eşleştirme</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="Varsayılan" />
			</combo_box>
			<spinner name="TexScaleU" label="Yatay ölçek" />
			<spinner name="TexScaleV" label="Dikey ölçek" />
			<spinner name="rptctrl" label="Metrede kaç kez tekrarlandığı" />
			<spinner name="TexRot" label="Dönüş derecesi" />
			<spinner name="TexOffsetU" label="Yatay ofset" />
			<spinner name="TexOffsetV" label="Dikey ofset" />
			<spinner name="bumpyScaleU" label="Yatay ölçek" />
			<spinner name="bumpyScaleV" label="Dikey ölçek" />
			<spinner name="bumpyRot" label="Dönüş derecesi" />
			<spinner name="bumpyOffsetU" label="Yatay ofset" />
			<spinner name="bumpyOffsetV" label="Dikey ofset" />
			<spinner name="shinyScaleU" label="Yatay ölçek" />
			<spinner name="shinyScaleV" label="Dikey ölçek" />
			<spinner name="shinyRot" label="Dönüş derecesi" />
			<spinner name="shinyOffsetU" label="Yatay ofset" />
			<spinner name="shinyOffsetV" label="Dikey ofset" />
			<check_box name="checkbox planar align" label="Planar yüzleri hizala" tool_tip="Tüm seçili yüzeylerdeki dokuları son seçili yüzdekiyle hizalar. Planar doku eşleştirmesi gerektirir." />
			<button name="button align textures" label="Hizala" label_selected="Geçerli doku katmanlarına hizala" tool_tip="Geçerli doku katmanlarına hizala" />
		</panel>
	</scroll_container>
</panel>