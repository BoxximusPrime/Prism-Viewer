				<combo_box.item name="Alpha masking" value="Alpha masking" label="Alfa maskeleme" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Yayımlatıcı maske" />
			</combo_box>
			<text name="label maskcutoff">Maske kesimi</text>
			<texture_picker name="bumpytexture control" label="Doku" tool_tip="Bir resim seçmek için tıklayın" />
			<text name="label bumpiness">Yumruluk</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Yok" />
				<combo_box.item name="Brightness" value="Brightness" label="Parlaklık" />
				<combo_box.item name="Darkness" value="Darkness" label="Koyuluk" />
				<combo_box.item name="woodgrain" value="woodgrain" label="damarlı ahşap" />
				<combo_box.item name="bark" value="bark" label="ağaç kabuğu" />
				<combo_box.item name="bricks" value="bricks" label="tuğlalar" />
				<combo_box.item name="checker" value="checker" label="dama tahtası" />
				<combo_box.item name="concrete" value="concrete" label="beton" />
				<combo_box.item name="crustytile" value="crustytile" label="sert çini" />
				<combo_box.item name="cutstone" value="cutstone" label="kesilmiş taş" />
				<combo_box.item name="discs" value="discs" label="diskler" />
				<combo_box.item name="gravel" value="gravel" label="çakıl" />
				<combo_box.item name="petridish" value="petridish" label="petri kabı" />
				<combo_box.item name="siding" value="siding" label="dış kaplama" />
				<combo_box.item name="stonetile" value="stonetile" label="taş çini" />
				<combo_box.item name="stucco" value="stucco" label="stükko" />
				<combo_box.item name="suction" value="suction" label="vakum" />
				<combo_box.item name="weave" value="weave" label="örgü" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Doku" tool_tip="Bir resim seçmek için tıklayın" />
			<text name="label shininess">Parıldama</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Yok" />
				<combo_box.item name="Low" value="Low" label="Düşük" />
				<combo_box.item name="Medium" value="Medium" label="Orta" />
				<combo_box.item name="High" value="High" label="Yüksek" />
			</combo_box>
			<text name="label glossiness">Pürüzsüzlük</text>
			<text name="label environment">Ortam</text>
			<text name="label shinycolor">Renk</text>
			<color_swatch name="shinycolorswatch" tool_tip="Renk seçiciyi açmak için tıklayın" />
