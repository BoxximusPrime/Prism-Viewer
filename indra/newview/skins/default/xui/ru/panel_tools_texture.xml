<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="Текстура">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">Цвет</text>
			<color_swatch name="colorswatch" tool_tip="Щелкните для выбора цвета" />
			<text name="color trans">Прозрачность %</text>
			<text name="glow label">Свечение</text>
			<check_box name="checkbox fullbright" label="Собственная яркость" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="Материалы" />
				<combo_box.item name="Media" value="Media" label="Медиа" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="Текстура (рассеянная)" ><radio_item.check_button label="Текстура (рассеянная)" label_selected="Текстура (рассеянная)" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="Шероховатость (обычная)" ><radio_item.check_button label="Шероховатость (обычная)" label_selected="Шероховатость (обычная)" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="Блеск (зеркальный)" ><radio_item.check_button label="Блеск (зеркальный)" label_selected="Блеск (зеркальный)" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="Повтор блокировки" tool_tip="Одновременно сверить все повторы карт" />
			<texture_picker name="texture control" label="Текстура" tool_tip="Щелкните для выбора изображения" />
			<text name="label alphamode">Альфа-режим</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="Нет" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="Альфа-смешивание" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="Альфа-маскирование" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="Излучающая маска" />
			</combo_box>
			<text name="label maskcutoff">Отсечка маски</text>
			<texture_picker name="bumpytexture control" label="Текстура" tool_tip="Щелкните для выбора изображения" />
			<text name="label bumpiness">Рельефность</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="Нет" />
				<combo_box.item name="Brightness" value="Brightness" label="Яркость" />
				<combo_box.item name="Darkness" value="Darkness" label="По темному" />
				<combo_box.item name="woodgrain" value="woodgrain" label="дерево" />
				<combo_box.item name="bark" value="bark" label="кора" />
				<combo_box.item name="bricks" value="bricks" label="кирпич" />
				<combo_box.item name="checker" value="checker" label="шахматная доска" />
				<combo_box.item name="concrete" value="concrete" label="бетон" />
				<combo_box.item name="crustytile" value="crustytile" label="старая плитка" />
				<combo_box.item name="cutstone" value="cutstone" label="тесаный камень" />
				<combo_box.item name="discs" value="discs" label="диски" />
				<combo_box.item name="gravel" value="gravel" label="гравий" />
				<combo_box.item name="petridish" value="petridish" label="чашка Петри" />
				<combo_box.item name="siding" value="siding" label="сайдинг" />
				<combo_box.item name="stonetile" value="stonetile" label="каменная плитка" />
				<combo_box.item name="stucco" value="stucco" label="штукатурка" />
				<combo_box.item name="suction" value="suction" label="присоска" />
				<combo_box.item name="weave" value="weave" label="переплетение" />
			</combo_box>
			<texture_picker name="shinytexture control" label="Текстура" tool_tip="Щелкните для выбора изображения" />
			<text name="label shininess">Блеск</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="Нет" />
				<combo_box.item name="Low" value="Low" label="Низкий" />
				<combo_box.item name="Medium" value="Medium" label="Средний" />
				<combo_box.item name="High" value="High" label="Высокий" />
			</combo_box>
			<text name="label glossiness">Глянец</text>
			<text name="label environment">Среда</text>
			<text name="label shinycolor">Цвет</text>
			<color_swatch name="shinycolorswatch" tool_tip="Щелкните для выбора цвета" />
			<text name="media_info">URL выбранного медиа (если есть)</text>
			<button name="add_media" label="Выбрать..." tool_tip="Добавить медиа" />
			<button name="delete_media" label="Удалить" tool_tip="Удалить медиа-текстуру" />
			<button name="button align" label="Выровнять" label_selected="Выровнять медиа" tool_tip="Масштабирование медиа-текстуры (сначала нужно загрузить)" />
			<text name="tex gen">Наложение</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="По умолчанию" />
				<combo_box.item name="Planar" value="Planar" label="На плоскость" />
			</combo_box>
			<spinner name="TexScaleU" label="Масштаб по горизонтали" />
			<spinner name="TexScaleV" label="Масштаб по вертикали" />
			<spinner name="rptctrl" label="Повторений на метр" />
			<spinner name="TexRot" label="Поворот, градусы" />
			<spinner name="TexOffsetU" label="Смещение по горизонтали" />
			<spinner name="TexOffsetV" label="Смещение по вертикали" />
			<spinner name="bumpyScaleU" label="Масштаб по горизонтали" />
			<spinner name="bumpyScaleV" label="Масштаб по вертикали" />
			<spinner name="bumpyRot" label="Поворот, градусы" />
			<spinner name="bumpyOffsetU" label="Смещение по горизонтали" />
			<spinner name="bumpyOffsetV" label="Смещение по вертикали" />
			<spinner name="shinyScaleU" label="Масштаб по горизонтали" />
			<spinner name="shinyScaleV" label="Масштаб по вертикали" />
			<spinner name="shinyRot" label="Поворот, градусы" />
			<spinner name="shinyOffsetU" label="Смещение по горизонтали" />
			<spinner name="shinyOffsetV" label="Смещение по вертикали" />
			<check_box name="checkbox planar align" label="Согласование" tool_tip="Согласование текстур на всех выбранных гранях по последней выбранной грани. Должно быть выбрано наложение по плоскостям." />
			<button name="button align textures" label="Выровнять" label_selected="Выровнять текущие слои текстуры" tool_tip="Выровнять текущие слои текстуры" />
		</panel>
	</scroll_container>
</panel>