<?xml version='1.0' encoding='utf-8'?>
<panel name="Texture" label="材質">
	<scroll_container name="texture_scroll">
		<panel name="texture_scroll_content">
			<text name="color label">顏色</text>
			<color_swatch name="colorswatch" tool_tip="點按以開啟顏色挑選器" />
			<text name="color trans">透明度 %</text>
			<text name="glow label">光暈</text>
			<check_box name="checkbox fullbright" label="全亮" />
			<combo_box name="combobox matmedia">
				<combo_box.item name="Materials" value="Materials" label="材料" />
				<combo_box.item name="Media" value="Media" label="媒體" />
			</combo_box>
			<radio_group name="radio_material_type">
				<radio_item name="Texture (diffuse)" value="0" label="材質（漫反射圖）" ><radio_item.check_button label="材質（漫反射圖）" label_selected="材質（漫反射圖）" /></radio_item>
				<radio_item name="Bumpiness (normal)" value="1" label="凹凸度（正交）" ><radio_item.check_button label="凹凸度（正交）" label_selected="凹凸度（正交）" /></radio_item>
				<radio_item name="Shininess (specular)" value="2" label="閃亮度（鏡反光）" ><radio_item.check_button label="閃亮度（鏡反光）" label_selected="閃亮度（鏡反光）" /></radio_item>
			</radio_group>
			<check_box name="checkbox_sync_settings" label="鎖住重覆" tool_tip="同時調整所有映射的重覆" />
			<texture_picker name="texture control" label="材質" tool_tip="點按以挑選圖片" />
			<text name="label alphamode">半透明模式</text>
			<combo_box name="combobox alphamode">
				<combo_box.item name="None" value="None" label="無" />
				<combo_box.item name="Alpha blending" value="Alpha blending" label="半透明攙混" />
				<combo_box.item name="Alpha masking" value="Alpha masking" label="半透明遮罩" />
				<combo_box.item name="Emissive mask" value="Emissive mask" label="自發光遮罩" />
			</combo_box>
			<text name="label maskcutoff">遮罩截斷值</text>
			<texture_picker name="bumpytexture control" label="材質" tool_tip="點按以挑選圖片" />
			<text name="label bumpiness">凹凸度</text>
			<combo_box name="combobox bumpiness">
				<combo_box.item name="None" value="None" label="無" />
				<combo_box.item name="Brightness" value="Brightness" label="亮度" />
				<combo_box.item name="Darkness" value="Darkness" label="暗度" />
				<combo_box.item name="woodgrain" value="woodgrain" label="木紋" />
				<combo_box.item name="bark" value="bark" label="樹皮" />
				<combo_box.item name="bricks" value="bricks" label="磚" />
				<combo_box.item name="checker" value="checker" label="格子" />
				<combo_box.item name="concrete" value="concrete" label="混凝土" />
				<combo_box.item name="crustytile" value="crustytile" label="粗花磚" />
				<combo_box.item name="cutstone" value="cutstone" label="石磚" />
				<combo_box.item name="discs" value="discs" label="圓盤" />
				<combo_box.item name="gravel" value="gravel" label="碎石" />
				<combo_box.item name="petridish" value="petridish" label="培養皿" />
				<combo_box.item name="siding" value="siding" label="側邊片" />
				<combo_box.item name="stonetile" value="stonetile" label="石磚格" />
				<combo_box.item name="stucco" value="stucco" label="彩色沙岩" />
				<combo_box.item name="suction" value="suction" label="吸附" />
				<combo_box.item name="weave" value="weave" label="編織" />
			</combo_box>
			<texture_picker name="shinytexture control" label="材質" tool_tip="點按以挑選圖片" />
			<text name="label shininess">閃亮度</text>
			<combo_box name="combobox shininess">
				<combo_box.item name="None" value="None" label="無" />
				<combo_box.item name="Low" value="Low" label="低" />
				<combo_box.item name="Medium" value="Medium" label="中" />
				<combo_box.item name="High" value="High" label="高" />
			</combo_box>
			<text name="label glossiness">光滑度</text>
			<text name="label environment">環境</text>
			<text name="label shinycolor">顏色</text>
			<color_swatch name="shinycolorswatch" tool_tip="點按以開啟顏色挑選器" />
			<text name="media_info">所選媒體如有 URL，置於此</text>
			<button name="add_media" label="選擇…" tool_tip="添加媒體" />
			<button name="delete_media" label="移除" tool_tip="刪除這個媒體材質" />
			<button name="button align" label="對齊" label_selected="對齊媒體" tool_tip="對齊媒體材質（須先載入）" />
			<text name="tex gen">映射方式</text>
			<combo_box name="combobox texgen">
				<combo_box.item name="Default" value="Default" label="預設" />
				<combo_box.item name="Planar" value="Planar" label="平面" />
			</combo_box>
			<spinner name="TexScaleU" label="水平刻度" />
			<spinner name="TexScaleV" label="垂直刻度" />
			<spinner name="rptctrl" label="每公尺重覆次數" />
			<spinner name="TexRot" label="旋轉角度" />
			<spinner name="TexOffsetU" label="水平偏距" />
			<spinner name="TexOffsetV" label="垂直偏距" />
			<spinner name="bumpyScaleU" label="水平刻度" />
			<spinner name="bumpyScaleV" label="垂直刻度" />
			<spinner name="bumpyRot" label="旋轉角度" />
			<spinner name="bumpyOffsetU" label="水平偏距" />
			<spinner name="bumpyOffsetV" label="垂直偏距" />
			<spinner name="shinyScaleU" label="水平刻度" />
			<spinner name="shinyScaleV" label="垂直刻度" />
			<spinner name="shinyRot" label="旋轉角度" />
			<spinner name="shinyOffsetU" label="水平偏距" />
			<spinner name="shinyOffsetV" label="垂直偏距" />
			<check_box name="checkbox planar align" label="對齊平面" tool_tip="以最後所選擇的面為基準，對齊全部所選擇的面上的材質。 這必須使用平面材質映射方式。" />
			<button name="button align textures" label="對齊" label_selected="對齊目前的材質層次" tool_tip="對齊目前的材質層次" />
		</panel>
	</scroll_container>
</panel>